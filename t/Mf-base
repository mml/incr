SRCS = $(shell cd ../../t; echo *.ss)

tests = catchall vectors procedures prims binprims expansion immed equiv tak numprims define multi ratnum
DIRS = output $(tests:%=run-%/out)

test: $(SRCS) $(tests)

$(tests): % : %.ss drivero | output run-%/out
	racket -e '(require "../s/test-driver.ss") (require "$@.ss") (parameterize ([output-dir "run-$@/out"] [precompiled-driver-object "../c/driver.o"]) (runtests))' \
		> output/$@.out 2> output/$@.err\
		|| ((cat output/$@.err; ../../t//last-test < output/$@.out) | less -RF; false) #|| (cat output/$@.out; false)

drivero:
	$(MAKE) -C ../c driver.o

$(DIRS):
	mkdir -p $@

$(SRCS):
	ln -s ../../t/$@
