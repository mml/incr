WORKDIR = out
TARGET = $(WORKDIR)/x-test-program
OBJECT = $(WORKDIR)/x-test-program.o
ASSEMBLY = $(WORKDIR)/x-test-program.s
SRCS = $(shell cd ../../s; echo *.ss)
zo_file = $(dir $(1))compiled/$(patsubst %.ss,%_ss.zo,$(notdir $(1)))
ZO_FILES = $(foreach file,$(SRCS) machine.ss config.ss,$(call zo_file,$(file)))
test_scheme = $(foreach file,$(SRCS),test-$(file))

.PHONY: test unit debug dump raco cat edit clean realclean zo

test: $(ZO_FILES) | $(WORKDIR)
	racket tests.ss

unit: $(ZO_FILES)
	raco test --table --fresh-user --deps -x -j 20 *.ss

debug: $(TARGET)
	gdb -q $<

dump: $(OBJECT)
	objdump -d $<

cat: $(ASSEMBLY)
	less -j.5 -J $<

edit: $(ASSEMBLY)
	$(EDITOR) $<

src: $(SRCS)

$(SRCS):
	ln -s ../../s/$@

$(test_scheme): test-% : %
	raco test test --table --fresh-user -x $<

ttt:
	echo $(test_scheme)

### A nasty mess showing how to do byte compilation.
zo:
	raco make -v -j 20 *.ss

$(ZO_FILES) : $(call zo_file,%.ss): %.ss | compiled
	raco make -v --no-deps $<

### clean rules
clean:
	rm -f $(ZO_FILES) $(WORKDIR)/*

realclean:
	rm -rf compiled $(WORKDIR)


### directories
compiled $(WORKDIR):
	mkdir -p $@
