#lang racket

(provide emit-prologue)
(provide emit-Labels)
(provide emit-epilogue)
(require "compile-shared.ss")
(provide emit-label emit-Code emit-scheme-entry emit-bss unique-label)

(define-constant wordsize-shift 2)
(define-constant wordsize 4)

;; TODO: Replace magic numbers #b11 and #b100 with named constants
;; #b11 (3) - fixnum tag mask (low 2 bits == 00 means fixnum)
;; #b100 (4) - odd bit for fixnums (shift 1 fixnum-shift)
;; These appear throughout the file in type checks and odd?/even?
;; Need to add fixnum-mask and fixnum-odd-bit constants to compile-shared.ss

(define (emit-prologue)
  (emit "  .arch armv8-a")
  (emit "  .syntax unified")
  (emit "  .arm")
  (emit "  .fpu vfp")
  (emit "  .eabi_attribute 28, 1")
  (emit "  .eabi_attribute 20, 1")
  (emit "  .eabi_attribute 21, 1")
  (emit "  .eabi_attribute 23, 3")
  (emit "  .eabi_attribute 24, 1")
  (emit "  .eabi_attribute 25, 1")
  (emit "  .eabi_attribute 26, 2")
  (emit "  .eabi_attribute 30, 2")
  (emit "  .eabi_attribute 34, 1")
  (emit "  .eabi_attribute 18, 4")
  (emit "  .text"))

; emit-Code emits a subroutine
(define (emit-Code code env) (match code
  [`(code (,x* ___) (,y* ___) ,body) ; free variables not implemented yet
    (emit "  str lr,[sp,#~a]" link-register-index (// "save LR"))
    (emit "  ldr ~a, [sp,#~a]" closure-register closure-index
          (// "load closure address"))
    (let-values ([(si env) (arg-env x* env)])
      (let ([env (clovar-env y* env)])
        (emit-expr body si env)))
    (emit "  ldr lr,[sp,#~a]" link-register-index) ; restore LR
    (emit "  bx lr")
    ]))

(define (arg-env x* env)
  (let loop ([x* x*] [arg-count 0] [arg-index arg0-index] [env env])
    (cond [(null? x*)
           (values arg-index env)]
          [else
            (loop (cdr x*)
                  (add1 arg-count)
                  (- arg-index (wordsize))
                  (extend-env (car x*) (cons "sp" arg-index) env))])))

(define (clovar-env y* env)
  (let loop ([y* y*] [clovar-count 0] [clovar-index clovar0-index] [env env])
    (cond [(null? y*)
           env]
          [else
            (loop (cdr y*)
                  (add1 clovar-count)
                  (+ clovar-index (wordsize))
                  (extend-env (car y*) (cons closure-register clovar-index) env))])))

(define (emit-scheme-entry expr env)
  (emit-begin-function "scheme_entry")
  (emit "  stmfd sp!, {lr}") ; Save LR
  (when (scramble-link-register?)
    (emit-move32 "lr" #xdeadbeef))
  (emit "  mov ~a,r0" heap-register) ; Save heap base
  (emit-expr expr (- 0 (wordsize)) env)
  (emit-label "scheme_return")
  (emit "  ldmfd sp!, {lr}") ;; Restore LR
  (emit "  bx lr")
  (emit-end-function "scheme_entry"))

(define (emit-varref x env)
  (let ([loc (lookup x env)])
    (if loc
        (emit "  ldr r0,[~a,#~a]" (car loc) (cdr loc) (// "~a" x))
        (error 'compile-program "Internal error: unbound variable ~a" x))))

(define-syntax (with-saved-registers stx)
  (syntax-case stx ()
    [(_ [si ()] expr ...)
     #'(let ([si si]) expr ...)]
    [(_ [si (reg)] expr ...)
     #'(begin
         (emit "  str ~a,[sp,#~a] /* save ~a */" reg si reg)
         (let ([si (- si (wordsize))])
           (with-saved-registers [si ()] expr ...))
         (emit "  ldr ~a,[sp,#~a] /* restore ~a */" reg si reg))]
    [(_ [si (r1 r2 ...)] expr ...)
     #'(begin
         (emit "  str ~a,[sp,#~a] /* save ~a */" r1 si r1)
         (let ([si (- si (wordsize))])
           (with-saved-registers [si (r2 ...)] expr ...))
         (emit "  ldr ~a,[sp,#~a] /* restore ~a */" r1 si r1))]))

(define-syntax (emit stx)
  (syntax-case stx (//)
    [(_ ifmt iarg ... (// cfmt carg ...))
     #'(emit/ (list cfmt carg ...) ifmt iarg ...)]
    [(_ ifmt iarg ...)
     #'(emit/ #f ifmt iarg ...)]))

(define (emit/ comment . args)
  (let ([ins (apply format args)])
    (if comment
     (let* ([comment (apply format comment)]
            [wslen (max 0 (- 24 (string-length ins)))]
            [ws (make-string wslen #\space)])
       (fprintf (compile-port) "~a~a@ ~a" ins ws comment))
      (apply fprintf (compile-port) args)))
  (newline (compile-port)))


(define (wordsize) 4)
(define (wordsize-shift) 2)
(define (cellsize) (* 2 wordsize))
(define (empty-env) '())
;;; Fixnums end in #b00.
;;; All other integral types end in #b1111
(define fixnum-clear #b11)
(define boolean-mask #b10111111)
(define boolean-tag  #b00101111)

;;; Register roles
;;; See also https://static.docs.arm.com/ihi0042/j/IHI0042J_2020Q2_aapcs32.pdf
;;; Chapter 6, Section 6.1
;; Caller-saved
; r0-r3 are argument and retun value registers also called a1-a4
; r12 should be treated as a scratch register... it could be altered by long
; jumps, in which case it's called the intra-procedure-call scratch register
; (IP)
; This makes r12 a good choice for the closure register, because it's a
; register we expect to be left alone only within a Scheme procedure.
; Intra-procedure jumps in our generated code won't disturb it, but calls to
; foreign functions and to other Scheme procedures *could*.  But in those
; cases, we already plan on restoring the closure-register after the subroutine
; returns.

;; Callee-saved
; r4-r8,r10 are variable registers also called v1-v5,v7
; r9 may have special meaning, but if not it can be treated as v6
;   under Linux, it doesn't appear to be special
; r11 is the frame pointer (FP) if used, otherwise v8
; r13 is the stack pointer (SP)

;; Special
; r14 is the link register (LR)
; r15 is the program counter (PC)

(define heap-register "r8")     ; aka v5 chosen arbitrarily
(define closure-register "r12") ; aka r12 see rationale above
;;; Scheme procedure calls
; Our calling convention expects
; sp-4 to be empty (we'll save the LR there)
; sp-8 to be a closure object
; sp-12 to be our first argument
(define link-register-index (* -1 (wordsize)))
(define closure-index (* -2 (wordsize)))
(define arg0-index (* -3 (wordsize)))
(define clovar0-index (wordsize))
(define (arg-index arg-count)
  (- arg0-index (* (wordsize) arg-count)))

; TODO: maybe make a fresh on one each compile-program invocation?
(define (make-labeler)
  (let ([x 0])
    (lambda (prefix)
      (set! x (+ x 1))
      (format "~a~a" prefix x))))

(define /unique-label (make-labeler))
(define unique-label
  (case-lambda
    [() (/unique-label "L")]
    [(prefix) (/unique-label prefix)]))

(define (emit-begin-function name)
  (emit "")
  (emit "  @ function ~a{{{" name)
  (emit "  .align 2")
  (emit "  .global ~a" name)
  (emit "  .type ~a, %function" name)
  (emit-label name))

(define (emit-end-function name)
  (emit ".size ~a, .-~a" name name)
  (emit "  @ function }}}~a" name)
  (emit ""))

(define (immediate? x)
  (cond [(integer? x) #t]
        [(boolean? x) #t]
        [(char? x) #t]
        [(null? x) #t]
        [else #f]))

(define (primcall? x)
  (if (list? x)
      (cond
        [(null? x) #f]
        [else
          (case (car x)
            [(add1 sub1 integer->char char->integer zero? not null? list? vector? + - = * < /
              cons car cdr make-vector vector-ref string-ref vector-set! vector-length
              make-ratnum numerator denominator rational? exact? integer?)
             #t]
            [else #f])])
          #f))

(define (let? x)
  (and (list? x)
       (eq? 'let (car x))))
(define (begin? x)
  (and (list? x)
       (not (null? x))
       (eq? 'begin (car x))))

(define (variable-ref? x)
  (symbol? x))

(define let-bindings cadr)
(define (let-body expr)
  `(begin ,@(cddr expr)))
(define begin-exprs cdr)

(define (if? x)
  (and (list? x)
       (eq? 'if (car x))))

(define if-test cadr)
(define if-conseq caddr)
(define if-altern cadddr)


(define (labelcall? x)
  (eq? 'labelcall (car x)))

(define (immediate-rep x)
  (cond [(integer? x) (shift (constant fixnum-shift) x)]
        [(boolean? x)
         (case x
           [(#f) (constant false-value)]
           [(#t) (constant true-value)])]
        [(char? x)
         (bitwise-or
           (shift (constant char-shift) (char->integer x))
           (constant char-tag))]
        [(null? x) (constant null-value)]
        [else (error 'compile-program "Unsupported immediate ~s" (pretty-format x))]))

(define (padbits x n-digits)
  (list->string
    (reverse
      (take (reverse (append (make-list n-digits #\0) (string->list (format "~b" x))))
            n-digits))))

(define (register->number s)
  (let ([cs (string->list s)])
    (cond
      [(null? cs) (error 'compile-program
                         "Internal error: empty string is not a valid register")]
      [(eq? "lr" s) #b1110]
      [else
        (case (car cs)
          [(#\r) (string->number (list->string (cdr cs)))]
          [else (error 'compile-program "Don't understand register ~s." s)])])))

(define emit-b
  (case-lambda
    [(addr) (emit-b 'always addr)]
    [(condition addr)
     (let ([instruction (case condition
                          [(always) "b"]
                          [(eq mi) (string-append "b" (symbol->string condition))])])
       (emit "  ~a ~a" instruction addr))]))

(define emit-move32
  (case-lambda
    [(dest val) (emit-move32 'always dest val)]
    [(condition dest val)
     (let ([cbits (case condition
                    [(always) "1110"]
                    [(eq) "0000"]
                    [(ne) "0001"]
                    [(ge) "1010"]
                    [(lt) "1011"]
                    [(le) "1101"]
                    [(gt) "1100"]
                    [else (error 'compile-program "Unsupported MOV condition ~a" condition)])])
       (define mov  "00110000")
       (define movt "00110100")
       (emit "  /* move32 ~a <- ~a */" dest val)
       (let ([rd (padbits (register->number dest) 4)]
             [lo12 (bitwise-and val #xfff)]
             [lo4 (shift -12 (bitwise-and val #xf000))]
             [hi (shift -16 val)]
             [ilabel (if (eq? 'always condition) "" (symbol->string condition))])
         (emit "  /* movw~a ~a,#~a */" ilabel dest (bitwise-and val #xffff))
         (emit "  .word 0b~a~a~a~a~a" cbits mov (padbits lo4 4) rd (padbits lo12 12))
         (unless (zero? hi)
           (let ([hi12 (bitwise-and hi #xfff)]
                 [hi4 (shift -12 (bitwise-and hi #xf000))])
             (emit "  /* movt~a ~a,#~a */" ilabel dest hi)
             (emit "  .word 0b~a~a~a~a~a" cbits movt (padbits hi4 4) rd (padbits hi12 12))))))]
    ))

(define (emit-move dest val)
  (emit-move32 dest val))

(define (emit-label l)
  (emit "~a:" l))

(define (emit-Closure label free* si env)
  (let* ([nfree (length free*)]               ; number of free variables
         [size (add1 nfree)]                  ; plus 1 for the label address
         [size (* (wordsize) size)]           ; in words
         [size (bitwise-and -8 (+ 11 size))]) ; align to next dword
    (emit "  @ closure ~a ~a{{{" label free*)
    ;(emit "  ldr r0,=~a" (lookup label env)   (// "load label in r0")) 
    (emit "  movw r0, #:lower16:~a" (lookup label env))
    (emit "  movt r0, #:upper16:~a" (lookup label env))
    (emit "  str r0,[~a]" heap-register       (// "write pointer into closure object"))
    (let loop ([free* free*] [index (wordsize)])
      (unless (null? free*)
        (emit-varref (car free*) env)
        (emit "  str r0,[~a,#~a]" heap-register index (// "free variable ~a" (car free*)))
        (loop (cdr free*) (+ index (wordsize)))))
    (emit "  orr r0,~a,#~a" heap-register (constant closure-tag))
    (emit "  add ~a,~a,#~a" heap-register heap-register size)
    (emit "  @ closure}}}")))

; emit-Tailcall sets up a tail call and then branches
(define (emit-Tailcall f e* si env)
  ; We are clobbering our incoming stack frame.  Even the LR, which we really
  ; should save.  We restore it first as a kludge.  In the future, we should
  ; emit a special Lx_tail label pointing to the spot right after where we save
  ; the LR on the stack.  Then we can branch to there instead.
  (emit "  @ tailcall{{{")
  (emit-expr f si env) ; r0 = closure
  (emit "  BIC r0,r0,#~a" (constant closure-tag)      (// "clear tag bits"))
  (emit "  str r0, [sp,#~a]" closure-index (// "put closure on stack"))
  ; We now have to evaluate all arguments and gradually add their values to the stack.
  (let loop ([e* e*] [arg-index arg0-index] [arg-count 0] [si arg0-index])
    (cond
      [(null? e*)
       (emit "  ldr r0,[sp,#~a]" closure-index       (// "load closure into r0"))
       (emit "  BIC r0,r0,#~a" (constant closure-tag)           (// "zero out tag"))
       (emit "  LDR r0,[r0]"                         (// "load branch target"))
       (emit "  LDR LR,[sp,#~a]" link-register-index (// "hack to preserve LR"))
       (emit "  bx r0")]
      [else
        (emit-expr (car e*) si env)
        (emit "  str r0, [sp,#~a]" arg-index   (// "store arg ~a" arg-count))
        (loop (cdr e*) (- arg-index (wordsize)) (add1 arg-count) (- si (wordsize)))]))
  (emit "  @ }}}tailcall"))

; emit-Funcall sets up a call and then branches
(define (emit-Funcall f e* si env)
  (emit "  @ funcall{{{")
  (emit-expr f si env) ; r0 = closure
  (let ([psi si]) ; procedure SI
    (emit "  BIC r0,r0,#~a" (constant closure-tag)              (// "clear tag bits"))
    (emit "  str r0, [sp,#~a]" (+ psi closure-index) (// "put closure on stack"))
    (let loop ([e* e*] [arg-index (+ psi arg0-index)] [arg-count 0] [si (+ psi arg0-index)])
      (cond
        [(null? e*)
         (emit "  ldr ~a, [sp,#~a]" closure-register (+ psi closure-index)
               (// "load closure address from stack"))
         (emit "  ldr ~a, [~a]" closure-register closure-register
               (// "dereference code pointer"))
         (emit "  sub sp,sp,#~a" (- psi) (// "set procedure SP"))
         (emit "  blx ~a" closure-register)
         (emit "  add sp,sp,#~a /* restore SP */" (- psi))
         (emit "  ldr ~a, [sp,#~a]" closure-register closure-index
               (// "restore closure address"))]
        [else
          (emit-expr (car e*) si env)
          (emit "  str r0, [sp,#~a] /* store arg ~a */"
                arg-index arg-count)
          (loop (cdr e*) (- arg-index (wordsize)) (add1 arg-count) (- si (wordsize)))])))
  (emit "  @ }}}funcall"))

(define (emit-allocation-primcall op expr si env)
  (case op
    [(cons)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "  str r0, [sp,#~a]" si) ; save car on the stack
     (emit-expr (primcall-operand2 expr) (- si (wordsize)) env)
     (emit "  str r0, [~a,#~a]" heap-register (wordsize)) ; store cdr
     (emit "  ldr r0, [sp,#~a]" si) ; recover car
     (emit "  str r0, [~a]" heap-register)
     (emit "  add r0,~a,#~a" heap-register (constant pair-tag))
     (emit "  add ~a,~a,#~a" heap-register heap-register (* 2 (wordsize)))]
    [(make-vector) ; using only r0 and r1... could be more efficient
     (emit "  @ make-vector{{{")
     (emit-expr (primcall-operand1 expr) si env)
     (emit "  lsr r0, #~a" (constant fixnum-shift) (// "fixnum->int"))
     (emit "  str r0, [sp,#~a]" si      (// "save size on stack"))
     (emit "  lsl r0, #~a" (wordsize)   (// "<< wordsize"))
     (emit "  add r0, r0, #11"          (// "align size to next"))
     (emit "  and r0, r0, #-8"          (// "   object boundary"))
     (emit "  str ~a, [sp,#~a]" heap-register (- si (wordsize))) ; save address on stack
     (emit "  add ~a,~a,r0" heap-register heap-register)
     (emit-expr (primcall-operand2 expr (shift (- (constant fixnum-shift)) #xdead0))
                (- si (wordsize) (wordsize)) env) ; r0 = initial value
     (emit "  ldr r2, [sp,#~a]" (- si (wordsize)) (// "pointer to vector"))
     (emit "  ldr r1, [sp,#~a]" si                (// "size"))
     (emit "  str r1, [r2],#~a" (wordsize)        (// "write size"))
     (let ([loop (unique-label "loop")] [break (unique-label "break")])
       (emit-label loop)
       (emit "  subs r1,r1,#1") ; decrement r1
       (emit-b 'mi break) ; if r1 < 0 goto break
       (emit "  str r0, [r2],#~a" (wordsize)) ; initialize word
       (emit-b 'always loop) ;
       (emit-label break))
     (emit "  ldr r0, [sp,#~a]" (- si (wordsize)) (// "restore pointer to vector"))
     (emit "  orr r0,r0,#~a" (constant vector-tag)           (// "tag vector"))
     (emit "  @ make-vector}}}")]
    [(string)
     (emit "  @ {{{string")
     (emit-move32 "r0" (primcall-operand-count expr))
     (emit "  add r1, r0, #~a" (+ 11 (constant wordsize))       (// "align size to next"))
     (emit "  and r1, r1, #-8"                                  (// "   object boundary"))
     (emit "  mov r2, ~a" heap-register)                        ; save addr in r2
     (emit "  add ~a,~a,r1" heap-register heap-register)
     (emit "  str r0, [r2]")
     (emit "  mov r0, r2")                                      ; copy (untagged) return value back to r0
     (emit "  add r2,r2, ~a" (constant wordsize))
     (for-each
       (lambda (operand)
         (emit-move32 "r3" (char->integer (cadr operand)))
         (emit "  str r3,[r2]")
         (emit "  add r2,r2,#1"))
       (primcall-operands expr))
     (emit "  orr r0,r0,#~a" (constant string-tag))
     (emit "  @ string}}}")]
    [(string->symbol)
     (emit "  @ {{{string->symbol")
     (emit-expr (primcall-operand1 expr) si env)    ; evaluate string argument to r0
     (emit "  str r0, [~a]" heap-register)           ; store string pointer at offset 0
     (emit "  orr r0,~a,#~a" heap-register (constant symbol-tag))  ; tag pointer with #b100
     (emit "  add ~a,~a,#8" heap-register heap-register)   ; advance heap by 8 bytes
     (emit "  @ string->symbol}}}")]
    [(make-ratnum)
     (emit-expr (primcall-operand1 expr) si env)    ; evaluate numerator argument to r0
     (emit "  str r0, [~a]" heap-register)           ; store numerator at offset 0
     (emit-expr (primcall-operand2 expr) (- si (wordsize)) env) ; evaluate denominator
     (emit "  str r0, [~a,#~a]" heap-register (wordsize)) ; store denominator at offset wordsize
     (emit "  orr r0,~a,#~a" heap-register (constant ratnum-tag)) ; tag pointer with #b101
     (emit "  add ~a,~a,#~a" heap-register heap-register (* 2 (wordsize)))] ; advance heap by 2 words
    ))

(define (emit-side-effect-primcall op expr si env)
  (case op
    [(vector-set!) ; vec n obj
     (emit "/* vector-set!{{{ */")
     (with-saved-registers [si ("r4" "r5")]
       (emit-expr (primcall-operand1 expr) si env)
       (emit "  BIC r4,r0, #~a" (constant vector-tag)      (// "clear vector tag"))
       (emit-expr (primcall-operand2 expr) si env)
       (emit "  LSR r5,r0,#~a" (constant fixnum-shift)     (// "offset fixnum->int"))
       (emit "  add r5,r5,#1"                   (// "skip over vector size"))
       (emit "  LSL r5,r5,#~a" (wordsize-shift) (// "multiply by wordsize"))
       (emit-expr (primcall-operand3 expr) si env) ; value in r0
       (emit "  str r0, [r4,r5]"                (// "dereference and store"))
       (emit "/* }}}vector-set! */"))]
    [else (error 'compile-program
                 "Unsupported primcall ~s in ~s" (pretty-format op) (pretty-format expr))]))

(define (emit-primitive-call expr si env)
  (let ([op (primcall-op expr)])
  (case op
    [(cons make-vector string string->symbol make-ratnum)
     (emit-allocation-primcall op expr si env)]
    [(vector-set!)
     (emit-side-effect-primcall op expr si env)]
    [(void)
     (emit-move32 "r0" (constant void-value))]
    [(add1)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "add r0,r0,#~a" (immediate-rep 1) (// "add1"))]
    [(sub1)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "sub r0,r0,#~a" (immediate-rep 1) (// "sub1"))]
    [(bitwise-arithmetic-shift-left bitwise-arithmetic-shift)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "  str r0, [sp,#~a]" si)
     (emit-expr (primcall-operand2 expr) si env)
     (emit "  ldr r1, [sp,#~a]" si)
     (emit "  ASRS r0,r0,#~a" (constant fixnum-shift) (// "fixnum->int"))
     (emit "  LSLPL r0,r1,r0")
     (emit "  RSBMI r0,r0,#0")
     (emit "  ASRMI r0,r1,r0")
     (emit "  BICMI r0,r0,#~a" fixnum-clear)]
    [(bitwise-arithmetic-shift-right)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "  str r0, [sp,#~a]" si)
     (emit-expr (primcall-operand2 expr) si env)
     (emit "  ldr r1, [sp,#~a]" si)
     (emit "  ASRS r0,r0,#~a" (constant fixnum-shift) (// "fixnum->int"))
     (emit "  ASRPL r0,r1,r0")
     (emit "  BICPL r0,r0,#~a" fixnum-clear)
     (emit "  RSBMI r0,r0,#0")
     (emit "  LSLMI r0,r1,r0")]
    [(zero?)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "cmp r0,#~a" (immediate-rep 0))
     (emit-move32 'eq "r0" (immediate-rep #t))
     (emit-move32 'ne "r0" (immediate-rep #f))]
    [(not)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "cmp r0,#~a" (immediate-rep #f))
     (emit-move32 'eq "r0" (immediate-rep #t))
     (emit-move32 'ne "r0" (immediate-rep #f))]
    [(null?)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "cmp r0,#~a" (immediate-rep '()))
     (emit-move32 'eq "r0" (immediate-rep #t))
     (emit-move32 'ne "r0" (immediate-rep #f))]
    [(list?)
     (emit-expr (primcall-operand1 expr) si env)
     (let ([done (unique-label "list_done")])
       (emit "cmp r0,#~a" (immediate-rep '()))
       (emit-move32 'eq "r0" (immediate-rep #t))
       (emit "beq ~a" done)
       (emit "and r1,r0,#0b111")
       (emit "cmp r1,#~a" (constant pair-tag))
       (emit-move32 'eq "r0" (immediate-rep #t))
       (emit-move32 'ne "r0" (immediate-rep #f))
       (emit-label done))]
    [(vector?)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "and r1,r0,#0b111")
     (emit "cmp r1,#~a" (constant vector-tag))
     (emit-move32 'eq "r0" (immediate-rep #t))
     (emit-move32 'ne "r0" (immediate-rep #f))]
    [(rational?)
     (emit-expr (primcall-operand1 expr) si env)
     (let ([end-label (unique-label "rat_end")])
       ; Check if fixnum (low 2 bits are 00)
       (emit "and r1,r0,#0b11")
       (emit "cmp r1,#0")
       (emit-move32 'eq "r0" (immediate-rep #t))
       (emit "beq ~a" end-label)
       ; Check if ratnum (low 3 bits are 101)
       (emit "and r1,r0,#0b111")
       (emit "cmp r1,#~a" (constant ratnum-tag))
       (emit-move32 'eq "r0" (immediate-rep #t))
       (emit-move32 'ne "r0" (immediate-rep #f))
       (emit-label end-label))]
    [(fixnum?)
     (emit-expr (primcall-operand1 expr) si env)
     ; Check if fixnum (low 2 bits are 00)
     (emit "and r1,r0,#0b11")
     (emit "cmp r1,#0")
     (emit-move32 'eq "r0" (immediate-rep #t))
     (emit-move32 'ne "r0" (immediate-rep #f))]
    [(number?)
     (emit-expr (primcall-operand1 expr) si env)
     (let ([end-label (unique-label "num_end")])
       ; Check if fixnum (low 2 bits are 00)
       (emit "and r1,r0,#0b11")
       (emit "cmp r1,#0")
       (emit-move32 'eq "r0" (immediate-rep #t))
       (emit "beq ~a" end-label)
       ; Check if ratnum (low 3 bits are 101)
       (emit "and r1,r0,#0b111")
       (emit "cmp r1,#~a" (constant ratnum-tag))
       (emit-move32 'eq "r0" (immediate-rep #t))
       (emit-move32 'ne "r0" (immediate-rep #f))
       (emit-label end-label))]
    [(exact?)
     (emit-expr (primcall-operand1 expr) si env)
     (let ([end-label (unique-label "exact_end")])
       ; Check if fixnum (low 2 bits are 00)
       (emit "and r1,r0,#0b11")
       (emit "cmp r1,#0")
       (emit-move32 'eq "r0" (immediate-rep #t))
       (emit "beq ~a" end-label)
       ; Check if ratnum (low 3 bits are 101)
       (emit "and r1,r0,#0b111")
       (emit "cmp r1,#~a" (constant ratnum-tag))
       (emit-move32 'eq "r0" (immediate-rep #t))
       (emit-move32 'ne "r0" (immediate-rep #f))
       (emit-label end-label))]
    [(integer?)
     (emit-expr (primcall-operand1 expr) si env)
     ; Only fixnums are integers (low 2 bits must be 00)
     (emit "and r1,r0,#0b11")
     (emit "cmp r1,#0")
     (emit-move32 'eq "r0" (immediate-rep #t))
     (emit-move32 'ne "r0" (immediate-rep #f))]
    [(integer->char)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "lsl r0,r0,#~a" (- (constant char-shift) (constant fixnum-shift)))
     (emit "orr r0,r0,#~a" (constant char-tag))]
    [(char->integer)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "asr r0,r0,#~a" (- (constant char-shift) (constant fixnum-shift)))]
    [(+)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "  str r0, [sp,#~a]" si)
     (emit-expr (primcall-operand2 expr) (- si (wordsize)) env)
     (emit "  ldr r1, [sp,#~a]" si)
     (emit "  add r0,r0,r1")]
    [(-)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "  str r0, [sp,#~a]" si)
     (emit-expr (primcall-operand2 expr) (- si (wordsize)) env)
     (emit "  ldr r1, [sp,#~a]" si)
     (emit "  sub r0,r1,r0")]
    [(fx=)
     ; Fixnum-only equality - no type checking (preamble does dispatch)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "  str r0, [sp,#~a]" si)
     (emit-expr (primcall-operand2 expr) (- si (wordsize)) env)
     (emit "  ldr r1, [sp,#~a]" si)
     (emit "  cmp r0,r1")
     (emit-move32 'eq "r0" (immediate-rep #t))
     (emit-move32 'ne "r0" (immediate-rep #f))]

    [(eq? eqv?)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "  str r0, [sp,#~a]" si)
     (emit-expr (primcall-operand2 expr) (- si (wordsize)) env)
     (emit "  ldr r1, [sp,#~a]" si)
     (emit "  cmp r0,r1")
     (emit-move32 'eq "r0" (immediate-rep #t))
     (emit-move32 'ne "r0" (immediate-rep #f))]
    [(fx<)
     ; Fixnum-only less-than - no type checking (preamble does dispatch)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "  str r0, [sp,#~a]" si)
     (emit-expr (primcall-operand2 expr) (- si (wordsize)) env)
     (emit "  ldr r1, [sp,#~a]" si)
     (emit "  cmp r1,r0")
     (emit-move32 'lt "r0" (immediate-rep #t))
     (emit-move32 'ge "r0" (immediate-rep #f))]
    [(fx>)
     ; Fixnum-only greater-than - no type checking (preamble does dispatch)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "  str r0, [sp,#~a]" si)
     (emit-expr (primcall-operand2 expr) (- si (wordsize)) env)
     (emit "  ldr r1, [sp,#~a]" si)
     (emit "  cmp r0,r1")
     (emit-move32 'lt "r0" (immediate-rep #t))
     (emit-move32 'ge "r0" (immediate-rep #f))]
    [(fx<=)
     ; Fixnum-only less-than-or-equal - no type checking (preamble does dispatch)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "  str r0, [sp,#~a]" si)
     (emit-expr (primcall-operand2 expr) (- si (wordsize)) env)
     (emit "  ldr r1, [sp,#~a]" si)
     (emit "  cmp r1,r0")
     (emit-move32 'le "r0" (immediate-rep #t))
     (emit-move32 'gt "r0" (immediate-rep #f))]
    [(fx>=)
     ; Fixnum-only greater-than-or-equal - no type checking (preamble does dispatch)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "  str r0, [sp,#~a]" si)
     (emit-expr (primcall-operand2 expr) (- si (wordsize)) env)
     (emit "  ldr r1, [sp,#~a]" si)
     (emit "  cmp r1,r0")
     (emit-move32 'ge "r0" (immediate-rep #t))
     (emit-move32 'lt "r0" (immediate-rep #f))]
    [(min)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "  str r0, [sp,#~a]" si)
     (emit-expr (primcall-operand2 expr) (- si (wordsize)) env)
     (emit "  ldr r1, [sp,#~a]" si)
     (emit "  cmp r1,r0")
     (emit "  movlt r0,r1")]
    [(max)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "  str r0, [sp,#~a]" si)
     (emit-expr (primcall-operand2 expr) (- si (wordsize)) env)
     (emit "  ldr r1, [sp,#~a]" si)
     (emit "  cmp r1,r0")
     (emit "  movgt r0,r1")]
    [(abs)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "  cmp r0,#0")
     (emit "  rsblt r0,r0,#0")]
    [(odd?)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "  tst r0,#0b100")
     (emit-move32 'ne "r0" (immediate-rep #t))
     (emit-move32 'eq "r0" (immediate-rep #f))]
    [(even?)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "  tst r0,#0b100")
     (emit-move32 'eq "r0" (immediate-rep #t))
     (emit-move32 'ne "r0" (immediate-rep #f))]
    [(positive?)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "  cmp r0,#0")
     (emit-move32 'gt "r0" (immediate-rep #t))
     (emit-move32 'le "r0" (immediate-rep #f))]
    [(negative?)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "  cmp r0,#0")
     (emit-move32 'lt "r0" (immediate-rep #t))
     (emit-move32 'ge "r0" (immediate-rep #f))]
    [(*)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "  str r0, [sp,#~a]" si)
     (emit-expr (primcall-operand2 expr) (- si (wordsize)) env)
     (emit "  ldr r1, [sp,#~a]" si)
     (emit "  asr r0,r0,#~a" (constant fixnum-shift)) ; Can we combine with ldr?
     (emit "  mul r0,r0,r1")]
    [(car)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "  ldr r0,[r0,#~a]" (- (constant pair-tag)))]
    [(cdr)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "  ldr r0,[r0,#~a]" (- (wordsize) (constant pair-tag)))]
    [(numerator)
     (emit-expr (primcall-operand1 expr) si env)
     ; Check if fixnum (low 2 bits are 00)
     (emit "  and r1,r0,#0b11")
     (emit "  cmp r1,#0")
     (let ([is-fixnum (unique-label "num_fixnum")]
           [done (unique-label "num_done")])
       (emit "  beq ~a" is-fixnum)
       ; Is ratnum: clear tag and load first word (numerator)
       (emit "  BIC r0,r0,#~a" (constant ratnum-tag))
       (emit "  ldr r0,[r0]")
       (emit "  b ~a" done)
       (emit-label is-fixnum)
       ; Is fixnum: return itself
       (emit-label done))]
    [(denominator)
     (emit-expr (primcall-operand1 expr) si env)
     ; Check if fixnum (low 2 bits are 00)
     (emit "  and r1,r0,#0b11")
     (emit "  cmp r1,#0")
     (let ([is-fixnum (unique-label "den_fixnum")]
           [done (unique-label "den_done")])
       (emit "  beq ~a" is-fixnum)
       ; Is ratnum: clear tag and load second word (denominator)
       (emit "  BIC r0,r0,#~a" (constant ratnum-tag))
       (emit "  ldr r0,[r0,#~a]" (wordsize))
       (emit "  b ~a" done)
       (emit-label is-fixnum)
       ; Is fixnum: return 1 as fixnum
       (emit "  mov r0,#~a" (immediate-rep 1))
       (emit-label done))]
    [(vector-length)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "  BIC r0,r0, #~a" (constant vector-tag))
     (emit "  ldr r0, [r0]")
     (emit "  lsl r0, #~a" (constant fixnum-shift) (// "int->fixnum"))]
    [(vector-ref)
     (emit "  @ vector-ref{{{")
     (with-saved-registers [si ("r4")]
       (emit-expr (primcall-operand1 expr) si env)
       (emit "  BIC r4,r0,#~a" (constant vector-tag)   (// "clear vector tag"))
       (emit-expr (primcall-operand2 expr) si env) ; offset in r0
       (emit "  LSR r1,r0,#~a" (constant fixnum-shift) (// "offset fixnum->int"))
       (emit "  add r1,r1,#1"               (// "skip over vector size"))
       (emit "  LSL r1,r1,#~a" (wordsize-shift) (// "multiply by wordsize"))
       (emit "  ldr r0, [r4,r1]"            (// "dereference and return")))
     (emit "  @ vector-ref}}}")]
    [(string-ref)
     (emit "  @ string-ref{{{")
     (with-saved-registers [si ("r4")]
       (emit-expr (primcall-operand1 expr) si env)
       (emit "  BIC r4,r0,#~a" (constant string-tag)   (// "clear string tag"))
       (emit-expr (primcall-operand2 expr) si env) ; index in r0 (fixnum)
       (emit "  LSR r1,r0,#~a" (constant fixnum-shift) (// "index fixnum->int"))
       (emit "  add r1,r1,#~a" (constant wordsize)     (// "skip size header"))
       (emit "  ldrb r0, [r4,r1]"           (// "load byte"))
       (emit "  LSL r0,r0,#~a" (constant char-shift)   (// "byte->char position"))
       (emit "  orr r0,r0,#~a" (constant char-tag)     (// "add char tag")))
     (emit "  @ string-ref}}}")]
    [(/)
     (emit "  @ division {{{")
     (with-saved-registers [si ("r4" "r5")]
       (emit-expr (primcall-operand1 expr) si env)        ; dividend in r0
       (emit "  mov r4, r0")                               ; r4 = dividend (fixnum)
       (emit-expr (primcall-operand2 expr) (- si (wordsize)) env) ; divisor in r0
       (emit "  mov r5, r0")                               ; r5 = divisor (fixnum)
       (emit "  asr r0,r0,#~a" (constant fixnum-shift))   ; divisor as int
       (emit "  asr r1,r4,#~a" (constant fixnum-shift))   ; dividend as int
       (emit "  sdiv r2,r1,r0")                            ; r2 = quotient
       (emit "  mul r3,r2,r0")                             ; r3 = quotient * divisor
       (emit "  sub r3,r1,r3")                             ; r3 = remainder
       (emit "  cmp r3,#0")                                ; check remainder
       (let ([exact-path (unique-label "exact_div")]
             [done-path (unique-label "div_done")]
             [norm-done (unique-label "norm_done")])
         (emit "  beq ~a" exact-path)
         ; Inexact path: r4 = dividend, r5 = divisor (both fixnums)
         ; Sign normalization: move sign to numerator
         (emit "  mov r0,r5")                               ; r0 = divisor
         (emit "  cmp r0,#0")                               ; check if divisor is negative
         (emit "  bge ~a" norm-done)                        ; if non-negative, skip
         ; Divisor is negative: negate both numerator and denominator
         (emit "  rsb r4,r4,#0")                            ; r4 = -r4 (negate numerator)
         (emit "  rsb r5,r5,#0")                            ; r5 = -r5 (negate denominator)
         (emit-label norm-done)
         ; GCD reduction: compute GCD(|numerator|, |denominator|) and reduce
         ; Extract ints from fixnums
         (emit "  asr r0,r4,#~a" (constant fixnum-shift)) ; r0 = numerator as int
         (emit "  asr r1,r5,#~a" (constant fixnum-shift)) ; r1 = denominator as int
         ; Make both positive for GCD computation
         (emit "  cmp r0,#0")
         (emit "  rsblt r0,r0,#0")                         ; abs(numerator)
         (emit "  cmp r1,#0")
         (emit "  rsblt r1,r1,#0")                         ; abs(denominator)
         ; GCD loop: r0 = a, r1 = b
         (let ([gcd-loop (unique-label "gcd_loop")]
               [gcd-done (unique-label "gcd_done")])
           (emit "  cmp r1,#0")
           (emit "  beq ~a" gcd-done)
           (emit-label gcd-loop)
           (emit "  cmp r1,#0")
           (emit "  beq ~a" gcd-done)
           (emit "  mov r2,r0")                             ; r2 = a
           (emit "  mov r0,r1")                             ; r0 = b
           (emit "  sdiv r3,r2,r1")                         ; r3 = a / b
           (emit "  mul r3,r3,r1")                          ; r3 = (a/b)*b
           (emit "  sub r1,r2,r3")                          ; r1 = a % b
           (emit "  b ~a" gcd-loop)
           (emit-label gcd-done))
         ; r0 now contains GCD
         ; Reduce numerator and denominator by GCD
         (emit "  asr r1,r4,#~a" (constant fixnum-shift)) ; r1 = original numerator as int
         (emit "  sdiv r1,r1,r0")                          ; r1 = numerator / GCD
         (emit "  lsl r1,r1,#~a" (constant fixnum-shift)) ; r1 = reduced numerator as fixnum
         (emit "  str r1, [~a]" heap-register)             ; store reduced numerator
         (emit "  asr r2,r5,#~a" (constant fixnum-shift)) ; r2 = original denominator as int
         (emit "  cmp r2,#0")
         (emit "  rsblt r2,r2,#0")                         ; make positive
         (emit "  sdiv r2,r2,r0")                          ; r2 = abs(denom) / GCD
         (emit "  lsl r2,r2,#~a" (constant fixnum-shift)) ; r2 = reduced denominator as fixnum
         (emit "  str r2, [~a,#~a]" heap-register (wordsize)) ; store reduced denominator
         (emit "  add r0,~a,#~a" heap-register (constant ratnum-tag))
         (emit "  add ~a,~a,#8" heap-register heap-register)
         (emit "  b ~a" done-path)
         (emit-label exact-path)
         ; Exact path: return quotient as fixnum
         (emit "  lsl r0,r2,#~a" (constant fixnum-shift))
         (emit-label done-path)))
     (emit "  @ division }}}")]
    [(quotient)
     (emit "  @ quotient{{{")
     (emit-expr (primcall-operand1 expr) si env)           ; dividend in r0 (fixnum)
     (emit "  str r0, [sp,#~a]" si)                        ; save dividend
     (emit-expr (primcall-operand2 expr) (- si (wordsize)) env)  ; divisor in r0 (fixnum)
     (emit "  ldr r1, [sp,#~a]" si)                        ; load dividend into r1
     (emit "  asr r0,r0,#~a" (constant fixnum-shift))      ; divisor fixnum->int
     (emit "  asr r1,r1,#~a" (constant fixnum-shift))      ; dividend fixnum->int
     (emit "  sdiv r0,r1,r0")                              ; r0 = r1 / r0 (dividend_int/divisor_int)
     (emit "  lsl r0,r0,#~a" (constant fixnum-shift))      ; int->fixnum
     (emit "  @ quotient}}}")]
    [(remainder)
     (emit "  @ remainder{{{")
     (emit-expr (primcall-operand1 expr) si env)           ; dividend in r0 (fixnum)
     (emit "  str r0, [sp,#~a]" si)                        ; save dividend
     (emit-expr (primcall-operand2 expr) (- si (wordsize)) env)  ; divisor in r0 (fixnum)
     (emit "  mov r2,r0")                                  ; save divisor in r2
     (emit "  ldr r1, [sp,#~a]" si)                        ; load dividend into r1
     (emit "  asr r0,r0,#~a" (constant fixnum-shift))      ; divisor fixnum->int
     (emit "  asr r1,r1,#~a" (constant fixnum-shift))      ; dividend fixnum->int
     (emit "  sdiv r3,r1,r0")                              ; r3 = quotient (int)
     (emit "  mul r3,r3,r0")                               ; r3 = quotient * divisor
     (emit "  sub r0,r1,r3")                               ; r0 = dividend - (quotient * divisor)
     (emit "  lsl r0,r0,#~a" (constant fixnum-shift))      ; int->fixnum
     (emit "  @ remainder}}}")]
    [(modulo)
     (let ([L-same-sign (unique-label "modulo_same_sign")]
           [L-end (unique-label "modulo_end")])
       (emit "  @ modulo{{{")
       (emit-expr (primcall-operand1 expr) si env)         ; dividend in r0 (fixnum)
       (emit "  str r0, [sp,#~a]" si)                      ; save dividend
       (emit-expr (primcall-operand2 expr) (- si (wordsize)) env)  ; divisor in r0 (fixnum)
       (emit "  str r0, [sp,#~a]" (- si (wordsize)))       ; save divisor on stack
       (emit "  mov r2,r0")                                ; save divisor in r2
       (emit "  ldr r1, [sp,#~a]" si)                      ; load dividend into r1
       (emit "  asr r0,r0,#~a" (constant fixnum-shift))    ; divisor fixnum->int
       (emit "  asr r1,r1,#~a" (constant fixnum-shift))    ; dividend fixnum->int
       (emit "  sdiv r3,r1,r0")                            ; r3 = quotient (int)
       (emit "  mul r3,r3,r0")                             ; r3 = quotient * divisor
       (emit "  sub r0,r1,r3")                             ; r0 = remainder (int)
       (emit "  lsl r0,r0,#~a" (constant fixnum-shift))    ; remainder int->fixnum
       ; Check if remainder is 0
       (emit "  cmp r0,#0")
       (emit "  beq ~a" L-end)                             ; if rem == 0, done
       ; Check if signs differ: XOR and test sign bit
       (emit "  eor r1,r0,r2")                             ; XOR remainder and divisor
       (emit "  cmp r1,#0")
       (emit "  bge ~a" L-same-sign)                       ; if same sign, done
       ; Different signs: add divisor to remainder
       (emit "  add r0,r0,r2")                             ; remainder += divisor
       (emit-label L-same-sign)
       (emit-label L-end)
       (emit "  @ modulo}}}"))
     ]
    [else (error 'compile-program "Unsupported primcall in ~s" (pretty-format expr))])))

(define (emit-begin exprs si env)
  (cond
    [(null? exprs) (void)]
    [else (emit-expr (car exprs) si env)
          (emit-begin (cdr exprs) si env)]))

(define (emit-let bindings body si env)
  (let f ([b* bindings]
          [new-env env]
          [si si])
    (cond
      [(null? b*) (emit-expr body si new-env)]
      [else
        (let ([b (car b*)])
          (emit-expr (rhs b) si env)
          (emit "  str r0, [sp,#~a]" si (// "let ~a" (lhs b)))
          (f (cdr b*)
             (extend-env (lhs b) (cons "sp" si) new-env)
             (- si (wordsize))))])))

(define (emit-if test conseq altern si env)
  (let ([L0 (unique-label)]
        [L1 (unique-label)])
    (emit-expr test si env)
    (emit "  cmp r0,#~a" (immediate-rep #f))
    (emit-b 'eq L0)
    (emit-expr conseq si env)
    (emit-b 'always L1)
    (emit-label L0)
    (emit-expr altern si env)
    (emit-label L1)))

(define (emit-expr expr si env) (match expr
  [`(quote ,c) (emit-move "r0" (immediate-rep c))]
  [(? symbol? x) (emit-varref x env)]
  [`(primcall ,pr ,e* ___) (emit-primitive-call `(,pr ,@e*) si env)]
  [`(begin ,e* ___) (emit-begin e* si env)]
  [`(let ,bindings ,body) (emit-let bindings body si env)]
  [`(if ,test ,conseq ,altern) (emit-if test conseq altern si env)]
  [`(closure ,label ,free* ___) (emit-Closure label free* si env)]
  [`(funcall ,f ,e* ___) (emit-Funcall f e* si env)]
  [`(tailcall ,f ,e* ___) (emit-Tailcall f e* si env)]))

; Currently unused
(define (emit-bss dlabels)
  (let ([names dlabels])
    ; TODO: should these be locals?
    (for-each (lambda (name) (emit ".global ~a" name))
              names)
    (emit ".bss")
    (emit ".align ~a" (constant wordsize-shift))
    (for-each (lambda (name)
                (emit ".type ~a, %object" name)
                (emit ".size ~a, ~a" name (constant wordsize))
                (emit-label name)
                (emit ".space ~a" (constant wordsize)))
              names)))

(define (emit-epilogue)
  (emit ".ident \"mml scheme compiler\"")
  (emit ".section .note.GNU-stack,\"\",%progbits"))

