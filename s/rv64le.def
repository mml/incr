#lang racket

(provide emit-prologue)
(provide emit-epilogue)
(require "compile-shared.ss")
(require racket/trace)
(provide emit-label emit-Code emit-scheme-entry emit-bss unique-label)

;;; https://riscv.org/wp-content/uploads/2015/01/riscv-calling.pdf
;;; https://en.wikichip.org/wiki/risc-v/registers
(define-constant wordsize 8)
(define-constant wordsize-shift 3)
(define closure-register "s10") ; aka x27, highest numbered callee-saved register
(define-constant closure-register closure-register)
(define-constant heap-register "s11") ; aka x27, highest numbered callee-saved register

; TODO: maybe make a fresh on one each compile-program invocation?
(define (make-labeler)
  (let ([x 0])
    (lambda (prefix)
      (set! x (+ x 1))
      (format "~a~a" prefix x))))

(define /unique-label (make-labeler))
(define unique-label
  (case-lambda
    [() (/unique-label "L")]
    [(prefix) (/unique-label prefix)]))

(define (emit . args)
  (apply fprintf (compile-port) args)
  (newline (compile-port)))

(define (emit-prologue)
  (emit "  .option pic")
  (emit "  .attribute arch, \"rv64i2p1_m2p0_a2p1_f2p2_d2p2_c2p0_zicsr2p0_zifencei2p0\"")
  (emit "  .attribute unaligned_access, 0")
  (emit "  .attribute stack_align, 16")
  (emit "  .text")
  (emit "  .align	1"))


(define (emit-Code code env) (match code
  [`(code (,x* ___) (,y* ___) ,body) ; free variables not implemented yet
    (emit "  sd ra,~a(sp)" (get-stack-index 'link-register))
    (emit "  ld ~a, ~a(sp)" closure-register (get-stack-index 'closure))
    ; load closure address
    (let-values ([(si env) (arg-env x* env)])
      (let ([env (clovar-env y* env)])
        (emit-expr body si env)))
    (emit "  ld ra,~a(sp)" (get-stack-index 'link-register)) ; restore LR
    (emit "  jr ra")
    ]))

(define (emit-scheme-entry expr env)
  (emit-begin-function "scheme_entry")
  (emit "  addi sp,sp,-~a" (constant wordsize))
  (emit "  sd ra,~a(sp)" (constant wordsize))
  (emit "  add ~a,a0,0" (constant heap-register)) ; Save heap base
  (emit-expr expr (- 0 (constant wordsize)) env)
  (emit-label "scheme_return")
  (emit "  ld ra,~a(sp)" (constant wordsize))
  (emit "  addi sp,sp,~a" (constant wordsize))
  (emit "  ret")
  (emit-end-function "scheme_entry"))

(define (emit-expr expr si env) (match expr
  [`(quote ,c) (emit "  li a0, ~a" (immediate-rep c))]
  [(? symbol? x) (emit-varref x env)]
  [`(primcall ,pr ,e* ___) (emit-primitive-call `(,pr ,@e*) si env)]
  [`(let ,bindings ,body) (emit-let bindings body si env)]
  [`(begin ,e* ___) (emit-begin e* si env)]
  [`(if ,test ,conseq ,altern) (emit-if test conseq altern si env)]
  [`(closure ,label ,free* ___) (emit-Closure label free* si env)]
  [`(funcall ,f ,e* ___) (emit-Funcall f e* si env)]
  [`(tailcall ,f ,e* ___) (emit-Tailcall f e* si env)]
  [`(constant-init ,n ,e) (emit-constant-init n e si env)]
  [`(constant-ref ,n) (emit-constant-ref n si env)]
  ))

(define (emit-constant-init name expr si env)
  (emit "/* constant-init ~a */" name)
  (emit-expr expr si env)
  (emit "  la t0,~a" name)
  (emit "  sd a0,(t0)"))

(define (emit-constant-ref name si env)
  (emit "/* constant-ref ~a */" name)
  (emit "  la a0,~a" name)
  (emit "  ld a0,(a0)"))

(define (emit-varref x env)
  (let ([loc (lookup x env)])
    (if loc
        (emit "  ld a0,~a(~a)" (cdr loc) (car loc))
        (error 'compile-program "Internal error: unbound variable ~a" x))))

(define-syntax (with-saved-registers stx)
  (syntax-case stx ()
    [(_ [si ()] expr ...)
     #'(let ([si si]) expr ...)]
    [(_ [si (reg)] expr ...)
     #'(begin
         (emit "  sd ~a,~a(sp) /* save ~a */" reg si reg)
         (let ([si (- si (constant wordsize))])
           (with-saved-registers [si ()] expr ...))
         (emit "  ld ~a, ~a(sp) /* restore ~a */" reg si reg))]
    [(_ [si (r1 r2 ...)] expr ...)
     #'(begin
         (emit "  sd ~a,~a(sp) /* save ~a */" r1 si r1)
         (let ([si (- si (constant wordsize))])
           (with-saved-registers [si (r2 ...)] expr ...))
         (emit "  ld ~a, ~a(sp) /* restore ~a */" r1 si r1))]))

(define (emit-begin exprs si env)
  (cond
    [(null? exprs) (void)]
    [else (emit-expr (car exprs) si env)
          (emit-begin (cdr exprs) si env)]))

(define (emit-let bindings body si env)
  (let f ([b* bindings]
          [new-env env]
          [si si])
    (cond
      [(null? b*) (emit-expr body si new-env)]
      [else
        (let ([b (car b*)])
          (emit-expr (rhs b) si env)
          (emit " sd a0,~a(sp)" si)
          (f (cdr b*)
             (extend-env (lhs b) (cons "sp" si) new-env)
             (- si (constant wordsize))))])))

(define (emit-if test conseq altern si env)
  (let ([L0 (unique-label)]
        [L1 (unique-label)])
    (emit-expr test si env)
    (emit "  li a1, ~a" (immediate-rep #f))
    (emit "  beq a0,a1,~a" L0)
    (emit-expr conseq si env)
    (emit "  j ~a" L1)
    (emit-label L0)
    (emit-expr altern si env)
    (emit-label L1)))

(define (emit-allocation-primcall op expr si env)
  (case op
    [(cons)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "  sd a0,~a(sp)" si)
     (emit-expr (primcall-operand2 expr) (- si (constant wordsize)) env)
     (emit "  sd a0, ~a(~a)" (constant wordsize) (constant heap-register)) ; store cdr
     (emit "  ld a0,~a(sp)" si) ; recover car
     (emit "  sd a0, (~a)" (constant heap-register))
     (emit "  add a0,~a,~a" (constant heap-register) (constant pair-tag))
     (emit "  add ~a,~a,~a" (constant heap-register) (constant heap-register) (* 2 (constant wordsize)))]
    [(make-vector)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "  srli a0,a0,~a" (constant fixnum-shift))
     (emit "  sd a0,~a(sp)" si)
     (emit "  slli a0,a0, ~a" (constant wordsize-shift))
     (emit "  add a0, a0, 11") ; align to next (8-byte)
     (emit "  and a0, a0, -8") ; object boundary
     (emit "  sd ~a, ~a(sp)" (constant heap-register) (- si (constant wordsize))) ; save address on stack
     (emit "  add ~a,~a,a0" (constant heap-register) (constant heap-register)) ; increment heap register
     (emit-expr (primcall-operand2 expr (shift (- (constant fixnum-shift)) #xdead0))
                (- si (constant wordsize) (constant wordsize)) env) ; a0 = initial value
     (emit "  ld t3, ~a(sp)" (- si (constant wordsize)) #;(// "pointer to vector"))
     (emit "  ld a1, ~a(sp)" si                #;(// "size"))
     (emit "  sd a1, (t3)"         #;(// "write size"))
     (let ([loop (unique-label "initialize_vector")] [break (unique-label "break")])
       (emit-label loop)
       (emit "  addi a1,a1,-1") ; decrement a1
       (emit "  blt a1,zero, ~a" break) ; if a1 < 0 goto break
       (emit "  addi t3,t3,~a" (constant wordsize)) ; move along the vector
       (emit "  sd a0, (t3)") ; initialize word
       (emit "  j ~a" loop)
       (emit-label break))
     (emit "  ld a0, ~a(sp)" (- si (constant wordsize)) #;(// "restore pointer to vector"))
     (emit "  or a0,a0,~a /* tag vector */" (constant vector-tag))]
    [(string)
     (let ([len (primcall-operand-count expr)])
       (emit "  li a0, ~a" len)         ; len in a0
       (emit "  add a1, a0, ~a" (+ 11 (constant wordsize))); align to next (8-byte)
       (emit "  and a1, a1, -8")        ; object boundary (in a1)
       (emit "  mv t0, ~a" (constant heap-register)) ; address in t0
       (emit "  add ~a,~a,a1" (constant heap-register) (constant heap-register)) ; increment heap register
       (emit "  sd a0, (t0)")           ; write size
       (emit "  mv a0, t0")             ; copy (untagged) return value back to a0
       (emit "  addi t0,t0, ~a" (constant wordsize))
       (for-each
         (lambda (operand)
           (emit "  li t2,~a" (char->integer (cadr operand)))
           (emit "  sb t2,(t0)")
           (emit "  addi t0,t0,1"))
         (primcall-operands expr))
       (emit "  ori a0,a0,~a" (constant string-tag)))]; return tagged ptr
    ))

(define (emit-side-effect-primcall op expr si env)
  (case op
    [(vector-set!) ; vec n obj
     (with-saved-registers [si ("s4" "s5")]
       (emit-expr (primcall-operand1 expr) si env)
       (emit "  li t0,~a" (bitwise-not (constant vector-tag)))
       (emit "  and s4,a0,t0") ; clear vector tag and move to s4
       (emit-expr (primcall-operand2 expr) si env)
       (emit "  srai s5,a0,~a" (constant fixnum-shift))
       (emit "  addi s5,s5,1") ; skip over vector size
       (emit "  slli s5,s5,~a" (constant wordsize-shift)) ; multiply by wordsize
       (emit-expr (primcall-operand3 expr) si env) ; value in a0
       (emit "  add s4,s4,s5")
       (emit "  sd a0, (s4)"))]
    [else (error 'compile-program
                 "Unsupported primcall ~s in ~s" (pretty-format op) (pretty-format expr))]))

(define (emit-primitive-call expr si env)
  (let ([op (primcall-op expr)])
    (emit "/* ~a {{{ */" op)
    (case op
      [(cons make-vector string)
       (emit-allocation-primcall op expr si env)]
      [(vector-set!)
       (emit-side-effect-primcall op expr si env)]
      [(void)
       (emit "li a0,~a" (constant void-value))]
      [(add1)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "addi a0,a0,~a" (immediate-rep 1))]
      [(sub1)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "addi a0,a0,~a" (immediate-rep -1))]
      [(zero?)
       (let ([L-zero (unique-label)]
             [L-end (unique-label)])
         (emit-expr (primcall-operand1 expr) si env)
         (emit "li a1, ~a" (immediate-rep 0))
         (emit "beq a0,a1,~a" L-zero)
         (emit "li a0, ~a" (constant false-value))
         (emit "j ~a" L-end)
         (emit-label L-zero)
         (emit "li a0, ~a" (constant true-value))
         (emit-label L-end))]
      [(not)
       (let ([L-false-operand (unique-label)]
             [L-end (unique-label)])
         (emit-expr (primcall-operand1 expr) si env)
         (emit "li a1, ~a" (immediate-rep #f))
         (emit "beq a0,a1,~a" L-false-operand)
         (emit "li a0, ~a" (immediate-rep #f))
         (emit "j ~a" L-end)
         (emit-label L-false-operand)
         (emit "li a0, ~a" (immediate-rep #t))
         (emit-label L-end))]
      [(null?)
       (emit-expr (primcall-operand1 expr) si env)
       (let ([L-null-operand (unique-label)]
             [L-end (unique-label)])
         (emit "li a1, ~a" (immediate-rep '()))
         (emit "beq a0,a1, ~a" L-null-operand)
         (emit "li a0, ~a" (immediate-rep #f))
         (emit "j ~a" L-end)
         (emit-label L-null-operand)
         (emit "li a0, ~a" (immediate-rep #t))
         (emit-label L-end))]
      [(integer->char)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "slli a0,a0,~a" (- (constant char-shift) (constant fixnum-shift)))
       (emit "ori  a0,a0,~a" (constant char-tag))]
      [(char->integer)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "srai a0,a0,~a" (- (constant char-shift) (constant fixnum-shift)))]
      [(+)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "sd a0,~a(sp)" si)
       (emit-expr (primcall-operand2 expr) (- si (constant wordsize)) env)
       (emit "ld a1,~a(sp)" si)
       (emit "add a0,a0,a1")]
      [(-)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "sd a0,~a(sp)" si)
       (emit-expr (primcall-operand2 expr) (- si (constant wordsize)) env)
       (emit "ld a1,~a(sp)" si)
       (emit "sub a0,a1,a0")]
      [(= eq? eqv?)
       (let ([L-operands-equal (unique-label)]
             [L-end (unique-label)])
         (emit-expr (primcall-operand1 expr) si env)
         (emit "sd a0,~a(sp)" si)
         (emit-expr (primcall-operand2 expr) (- si (constant wordsize)) env)
         (emit "ld a1,~a(sp)" si)
         (emit "  beq a0,a1, ~a" L-operands-equal)
         (emit "li a0, ~a" (immediate-rep #f))
         (emit "j ~a" L-end)
         (emit-label L-operands-equal)
         (emit "li a0, ~a" (immediate-rep #t))
         (emit-label L-end))]
      [(<)
       (let ([L-return-true (unique-label)]
             [L-end (unique-label)])
         (emit-expr (primcall-operand1 expr) si env)
         (emit "sd a0,~a(sp)" si)
         (emit-expr (primcall-operand2 expr) (- si (constant wordsize)) env)
         (emit "ld a1,~a(sp)" si)
         (emit "  blt a1,a0, ~a" L-return-true)
         (emit "li a0, ~a" (immediate-rep #f))
         (emit "j ~a" L-end)
         (emit-label L-return-true)
         (emit "li a0, ~a" (immediate-rep #t))
         (emit-label L-end))]
      [(>)
       (let ([L-return-true (unique-label)]
             [L-end (unique-label)])
         (emit-expr (primcall-operand1 expr) si env)
         (emit "sd a0,~a(sp)" si)
         (emit-expr (primcall-operand2 expr) (- si (constant wordsize)) env)
         (emit "ld a1,~a(sp)" si)
         (emit "  blt a0,a1, ~a" L-return-true)
         (emit "li a0, ~a" (immediate-rep #f))
         (emit "j ~a" L-end)
         (emit-label L-return-true)
         (emit "li a0, ~a" (immediate-rep #t))
         (emit-label L-end))]
      [(*)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "sd a0,~a(sp)" si)
       (emit-expr (primcall-operand2 expr) (- si (constant wordsize)) env)
       (emit "ld a1,~a(sp)" si)
       (emit "srai a0,a0,~a" (constant fixnum-shift))
       (emit "mul a0,a0,a1")]
      [(bitwise-arithmetic-shift-left bitwise-arithmetic-shift)
       (let ([L-negative-operand (unique-label)]
             [L-end (unique-label)])
         (emit-expr (primcall-operand1 expr) si env)
         (emit "sd a0,~a(sp)" si)
         (emit-expr (primcall-operand2 expr) (- si (constant wordsize)) env)
         (emit "ld a1,~a(sp)" si)
         (emit "srai a0,a0,~a" (constant fixnum-shift))
         (emit "srai a1,a1,~a" (constant fixnum-shift))
         (emit "blt a0,zero,~a" L-negative-operand)
         (emit "sll a0,a1,a0")
         (emit "j ~a" L-end)
         (emit-label L-negative-operand)
         (emit "sub a0,zero,a0")
         (emit "sra a0, a1, a0")
         (emit-label L-end)
         (emit "sll a0,a0,~a" (constant fixnum-shift)))]
      [(bitwise-arithmetic-shift-right)
       (let ([L-negative-operand (unique-label)]
             [L-end (unique-label)])
         (emit-expr (primcall-operand1 expr) si env)
         (emit "sd a0,~a(sp)" si)
         (emit-expr (primcall-operand2 expr) (- si (constant wordsize)) env)
         (emit "ld a1,~a(sp)" si)
         (emit "srai a0,a0,~a" (constant fixnum-shift))
         (emit "srai a1,a1,~a" (constant fixnum-shift))
         (emit "blt a0,zero,~a" L-negative-operand)
         (emit "sra a0, a1, a0")
         (emit "j ~a" L-end)
         (emit-label L-negative-operand)
         (emit "sub a0,zero,a0")
         (emit "sll a0,a1,a0")
         (emit-label L-end))
         (emit "slli a0,a0,~a" (constant fixnum-shift))]
      [(car)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "  li a1,~a" (constant pair-tag))
       (emit "  sub a0,a0,a1")
       (emit "  ld a0,(a0)")]
      [(cdr)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "  li a1,~a" (constant pair-tag))
       (emit "  sub a0,a0,a1")
       (emit "  ld a0,~a(a0)" (constant wordsize))]
      [(cadr)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "  li a1,~a" (constant pair-tag))
       (emit "  sub a0,a0,a1")
       (emit "  ld a0,~a(a0)" (constant wordsize))
       (emit "  sub a0,a0,a1")
       (emit "  ld a0,0(a0)")]
      [(cddr)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "  li a1,~a" (constant pair-tag))
       (emit "  sub a0,a0,a1")
       (emit "  ld a0,~a(a0)" (constant wordsize))
       (emit "  sub a0,a0,a1")
       (emit "  ld a0,~a(a0)" (constant wordsize))]
      [(caddr)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "  li a1,~a" (constant pair-tag))
       (emit "  sub a0,a0,a1")
       (emit "  ld a0,~a(a0)" (constant wordsize))
       (emit "  sub a0,a0,a1")
       (emit "  ld a0,~a(a0)" (constant wordsize))
       (emit "  sub a0,a0,a1")
       (emit "  ld a0,(a0)")]
      [(vector-length)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "  li a1,~a" (bitwise-not (constant vector-tag)))
       (emit "  and a0,a0,a1")
       (emit "  ld a0, (a0)")
       (emit "  slli a0,a0, ~a" (constant fixnum-shift))]
      [(vector-ref)
       (with-saved-registers [si ("s4")]
         (emit-expr (primcall-operand1 expr) si env)
         (emit "  li t0,~a" (bitwise-not (constant vector-tag)))
         (emit "  and s4,a0,t0")
         (emit-expr (primcall-operand2 expr) si env) ; offset in a0
         (emit "  srli a1,a0,~a" (constant fixnum-shift)); (// "offset fixnum->int"))
         (emit "  addi a1,a1,1");               (// "skip over vector size"))
         (emit "  slli a1,a1,~a" (constant wordsize-shift)); (// "multiply by wordsize"))
         (emit "  add s4,s4,a1")
         (emit "  ld a0, (s4)"))];            (// "dereference and return")))]

      [else (error 'compile-program "Unsupported primcall in ~s" (pretty-format expr))])
    (emit "/* }}} end ~a */" op )))

(define (immediate-rep x)
  (cond [(integer? x) (shift (constant fixnum-shift) x)]
        [(boolean? x)
         (case x
           [(#f) (constant false-value)]
           [(#t) (constant true-value)])]
        [(char? x)
         (bitwise-or
           (shift (constant char-shift) (char->integer x))
           (constant char-tag))]
        [(null? x) (constant null-value)]
        [else (error 'compile-program "Unsupported immediate ~s" (pretty-format x))]))

(define (emit-begin-function name)
  (emit "")
  (emit "  .align 1")
  (emit "  .globl  ~a" name)
  (emit "  .type   ~a, @function" name)
  (emit-label name))

(define (emit-label l)
  (emit "~a:" l))

(define (emit-Closure label free* si env)
  (let* ([nfree (length free*)]               ; number of free variables
         [size (add1 nfree)]                  ; plus 1 for the label address
         [size (* (constant wordsize) size)]           ; in words
         [size (bitwise-and -8 (+ 11 size))]) ; align to next dword
    (emit "  la a0,~a /* ~a */" (lookup label env) label)
    (emit "  sd a0,(~a)" (constant heap-register))
    (let loop ([free* free*] [index (constant wordsize)])
      (unless (null? free*)
        (emit-varref (car free*) env)
        (emit "  sd a0,~a(~a)" index (constant heap-register))
        (loop (cdr free*) (+ index (constant wordsize)))))
    (emit "  ori a0,~a,~a" (constant heap-register) (constant closure-tag))
    (emit "  addi ~a,~a,~a" (constant heap-register) (constant heap-register) size)))


; emit-Tailcall sets up a tail call and then branches
(define (emit-Tailcall f e* si env)
  ; We are clobbering our incoming stack frame.  Even the LR, which we really
  ; should save.  We restore it first as a kludge.  In the future, we should
  ; emit a special Lx_tail label pointing to the spot right after where we save
  ; the LR on the stack.  Then we can branch to there instead.
  (emit-expr f si env) ; a0 = closure
  (emit "  li t0,~a" (bitwise-not (constant closure-tag)))
  (emit "  and a0,a0,t0 /* clear tailcall tag bits */") ; clear tag bits
  (emit "  sd a0, ~a(sp)" (get-stack-index 'closure)) ; put closure on the stack
  ; We now have to evaluate all arguments and gradually add their values to the stack.
  (let loop ([e* e*] [arg-index arg0-index] [arg-count 0] [si arg0-index])
    (cond
      [(null? e*)
       (emit "  ld a0,~a(sp)" (get-stack-index 'closure))
       (emit "  ld a0,(a0) /* load branch target */")
       (emit "  ld ra,~a(sp)" (get-stack-index 'link-register))
       (emit "  jr a0")]
      [else
        (emit-expr (car e*) si env)
        (emit "  sd a0, ~a(sp)" arg-index)
        (loop (cdr e*) (- arg-index (constant wordsize)) (add1 arg-count) (- si (constant wordsize)))])))


(define arg0-index (* -3 (constant wordsize)))
; emit-Funcall sets up a call and then branches
(define (emit-Funcall f e* si env)
  (emit-expr f si env) ; a0 = closure
  (let ([psi si]) ; procedure SI
    (emit "  li t0,~a" (bitwise-not (constant closure-tag)))
    (emit "  and a0,a0,t0")
    (emit "  sd a0, ~a(sp)" (+ psi (get-stack-index 'closure)))
    (let loop ([e* e*] [arg-index (+ psi arg0-index)] [arg-count 0] [si (+ psi arg0-index)])
      (cond
        [(null? e*)
         (emit "  ld ~a, ~a(sp) /* load closure from stack */" closure-register (+ psi (get-stack-index 'closure)))
         (emit "  ld ~a, (~a) /* dereference code pointer */" closure-register closure-register)
         (emit "  addi sp,sp,~a /* set procedure SP */" psi )
         (emit "  jalr ra,~a,0" closure-register)
         (emit "  addi sp,sp,~a /* restore SP */" (- psi))
         (emit "  ld ~a, ~a(sp) /* restore closure address */" closure-register (get-stack-index 'closure))]
        [else
          (emit-expr (car e*) si env)
          (emit "  sd a0, ~a(sp) /* store arg ~a */" arg-index arg-count)
          (loop (cdr e*) (- arg-index (constant wordsize)) (add1 arg-count) (- si (constant wordsize)))]))))


(define (emit-end-function name)
  (emit "  .size ~a, .-~a" name name))

(define (emit-bss dlabels)
  (let ([names dlabels])
    ; TODO: should these be locals?
    (for-each (lambda (name) (emit ".globl ~a" name))
              names)
    (emit ".bss")
    (emit ".align ~a" (constant wordsize-shift))
    (for-each (lambda (name)
                (emit ".type ~a, @object" name)
                (emit ".size ~a, ~a" name (constant wordsize))
                (emit-label name)
                (emit ".zero ~a" (constant wordsize)))
              names)))

(define (emit-epilogue)
  (emit ".ident         \"mml scheme compiler\"")
  (emit ".section       .note.GNU-stack,\"\",@progbits"))
