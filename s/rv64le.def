#lang racket

(provide emit-prologue)
(provide emit-epilogue)
(require "compile-shared.ss")
(require racket/trace)
(provide emit-label emit-Code emit-scheme-entry emit-bss unique-label)

;;; https://riscv.org/wp-content/uploads/2015/01/riscv-calling.pdf
;;; https://en.wikichip.org/wiki/risc-v/registers
(define-constant wordsize 8)
(define-constant wordsize-shift 3)
(define closure-register "s10") ; aka x27, highest numbered callee-saved register
(define-constant closure-register closure-register)
(define-constant heap-register "s11") ; aka x27, highest numbered callee-saved register

;; TODO: Replace magic numbers #b11 and #b100 with named constants
;; #b11 (3) - fixnum tag mask (low 2 bits == 00 means fixnum)
;; #b100 (4) - odd bit for fixnums (shift 1 fixnum-shift)
;; These appear throughout the file in type checks and odd?/even?
;; Need to add fixnum-mask and fixnum-odd-bit constants to compile-shared.ss

; TODO: maybe make a fresh on one each compile-program invocation?
(define (make-labeler)
  (let ([x 0])
    (lambda (prefix)
      (set! x (+ x 1))
      (format "~a~a" prefix x))))

(define /unique-label (make-labeler))
(define unique-label
  (case-lambda
    [() (/unique-label "L")]
    [(prefix) (/unique-label prefix)]))

(define (emit . args)
  (apply fprintf (compile-port) args)
  (newline (compile-port)))

(define (emit-prologue)
  (emit "  .option pic")
  (emit "  .attribute arch, \"rv64i2p1_m2p0_a2p1_f2p2_d2p2_c2p0_zicsr2p0_zifencei2p0\"")
  (emit "  .attribute unaligned_access, 0")
  (emit "  .attribute stack_align, 16")
  (emit "  .text")
  (emit "  .align	1"))


(define (emit-Code code env) (match code
  [`(code (,x* ___) (,y* ___) ,body) ; free variables not implemented yet
    (emit "  sd ra,~a(sp)" (get-stack-index 'link-register))
    (emit "  ld ~a, ~a(sp)" closure-register (get-stack-index 'closure))
    ; load closure address
    (let-values ([(si env) (arg-env x* env)])
      (let ([env (clovar-env y* env)])
        (emit-expr body si env)))
    (emit "  ld ra,~a(sp)" (get-stack-index 'link-register)) ; restore LR
    (emit "  jr ra")
    ]))

(define (emit-scheme-entry expr env)
  (emit-begin-function "scheme_entry")
  (emit "  addi sp,sp,-~a" (constant wordsize))
  (emit "  sd ra,~a(sp)" (constant wordsize))
  (emit "  add ~a,a0,0" (constant heap-register)) ; Save heap base
  (emit-expr expr (- 0 (constant wordsize)) env)
  (emit-label "scheme_return")
  (emit "  ld ra,~a(sp)" (constant wordsize))
  (emit "  addi sp,sp,~a" (constant wordsize))
  (emit "  ret")
  (emit-end-function "scheme_entry"))

(define (emit-expr expr si env) (match expr
  [`(quote ,c) (emit "  li a0, ~a" (immediate-rep c))]
  [(? symbol? x) (emit-varref x env)]
  [`(primcall ,pr ,e* ___) (emit-primitive-call `(,pr ,@e*) si env)]
  [`(let ,bindings ,body) (emit-let bindings body si env)]
  [`(begin ,e* ___) (emit-begin e* si env)]
  [`(if ,test ,conseq ,altern) (emit-if test conseq altern si env)]
  [`(closure ,label ,free* ___) (emit-Closure label free* si env)]
  [`(funcall ,f ,e* ___) (emit-Funcall f e* si env)]
  [`(tailcall ,f ,e* ___) (emit-Tailcall f e* si env)]
  ))

(define (emit-varref x env)
  (let ([loc (lookup x env)])
    (if loc
        (emit "  ld a0,~a(~a)" (cdr loc) (car loc))
        (error 'compile-program "Internal error: unbound variable ~a" x))))

(define-syntax (with-saved-registers stx)
  (syntax-case stx ()
    [(_ [si ()] expr ...)
     #'(let ([si si]) expr ...)]
    [(_ [si (reg)] expr ...)
     #'(begin
         (emit "  sd ~a,~a(sp) /* save ~a */" reg si reg)
         (let ([si (- si (constant wordsize))])
           (with-saved-registers [si ()] expr ...))
         (emit "  ld ~a, ~a(sp) /* restore ~a */" reg si reg))]
    [(_ [si (r1 r2 ...)] expr ...)
     #'(begin
         (emit "  sd ~a,~a(sp) /* save ~a */" r1 si r1)
         (let ([si (- si (constant wordsize))])
           (with-saved-registers [si (r2 ...)] expr ...))
         (emit "  ld ~a, ~a(sp) /* restore ~a */" r1 si r1))]))

(define (emit-begin exprs si env)
  (cond
    [(null? exprs) (void)]
    [else (emit-expr (car exprs) si env)
          (emit-begin (cdr exprs) si env)]))

(define (emit-let bindings body si env)
  (let f ([b* bindings]
          [new-env env]
          [si si])
    (cond
      [(null? b*) (emit-expr body si new-env)]
      [else
        (let ([b (car b*)])
          (emit-expr (rhs b) si env)
          (emit " sd a0,~a(sp)" si)
          (f (cdr b*)
             (extend-env (lhs b) (cons "sp" si) new-env)
             (- si (constant wordsize))))])))

(define (emit-if test conseq altern si env)
  (let ([L0 (unique-label)]
        [L1 (unique-label)])
    (emit-expr test si env)
    (emit "  li a1, ~a" (immediate-rep #f))
    (emit "  beq a0,a1,~a" L0)
    (emit-expr conseq si env)
    (emit "  j ~a" L1)
    (emit-label L0)
    (emit-expr altern si env)
    (emit-label L1)))

(define (emit-allocation-primcall op expr si env)
  (case op
    [(cons)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "  sd a0,~a(sp)" si)
     (emit-expr (primcall-operand2 expr) (- si (constant wordsize)) env)
     (emit "  sd a0, ~a(~a)" (constant wordsize) (constant heap-register)) ; store cdr
     (emit "  ld a0,~a(sp)" si) ; recover car
     (emit "  sd a0, (~a)" (constant heap-register))
     (emit "  add a0,~a,~a" (constant heap-register) (constant pair-tag))
     (emit "  add ~a,~a,~a" (constant heap-register) (constant heap-register) (* 2 (constant wordsize)))]
    [(make-vector)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "  srli a0,a0,~a" (constant fixnum-shift))
     (emit "  sd a0,~a(sp)" si)
     (emit "  slli a0,a0, ~a" (constant wordsize-shift))
     (emit "  add a0, a0, 11") ; align to next (8-byte)
     (emit "  and a0, a0, -8") ; object boundary
     (emit "  sd ~a, ~a(sp)" (constant heap-register) (- si (constant wordsize))) ; save address on stack
     (emit "  add ~a,~a,a0" (constant heap-register) (constant heap-register)) ; increment heap register
     (emit-expr (primcall-operand2 expr (shift (- (constant fixnum-shift)) #xdead0))
                (- si (constant wordsize) (constant wordsize)) env) ; a0 = initial value
     (emit "  ld a2, ~a(sp)" (- si (constant wordsize)) #;(// "pointer to vector"))
     (emit "  ld a1, ~a(sp)" si                #;(// "size"))
     (emit "  sd a1, (a2)"         #;(// "write size"))
     (let ([loop (unique-label ".L")] [start (unique-label ".L")])
       (emit "  j ~a" start)
       (emit-label loop)
       (emit "  addi a2,a2,~a" (constant wordsize)) ; move along the vector
       (emit "  sd a0, (a2)") ; initialize word
       (emit-label start)
       (emit "  addi a1,a1,-1") ; decrement a1
       ; TODO(mml): If we could change this to to branch when a1<>0, this could
       ; be an RVC instruction
       (emit "  bge a1,zero, ~a" loop)) ; while a1 >= 0
     (emit "  ld a0, ~a(sp)" (- si (constant wordsize)) #;(// "restore pointer to vector"))
     (emit "  or a0,a0,~a /* tag vector */" (constant vector-tag))]
    [(string)
     (let ([len (primcall-operand-count expr)])
       (emit "  li a0, ~a" len)         ; len in a0
       (emit "  add a1, a0, ~a" (+ 11 (constant wordsize))); align to next (8-byte)
       (emit "  and a1, a1, -8")        ; object boundary (in a1)
       (emit "  mv t0, ~a" (constant heap-register)) ; address in t0
       (emit "  add ~a,~a,a1" (constant heap-register) (constant heap-register)) ; increment heap register
       (emit "  sd a0, (t0)")           ; write size
       (emit "  mv a0, t0")             ; copy (untagged) return value back to a0
       (emit "  addi t0,t0, ~a" (constant wordsize))
       (for-each
         (lambda (operand)
           (emit "  li t2,~a" (char->integer (cadr operand)))
           (emit "  sb t2,(t0)")
           (emit "  addi t0,t0,1"))
         (primcall-operands expr))
       (emit "  ori a0,a0,~a" (constant string-tag)))]  ; return tagged ptr
    [(string->symbol)
     (emit-expr (primcall-operand1 expr) si env)              ; evaluate string argument to a0
     (emit "  sd a0, (~a)" (constant heap-register))          ; store string pointer at offset 0
     (emit "  ori a0,~a,~a" (constant heap-register) (constant symbol-tag))  ; tag pointer with #b100
     (emit "  addi ~a,~a,8" (constant heap-register) (constant heap-register))]  ; advance heap by 8 bytes
    [(make-ratnum)
     (emit-expr (primcall-operand1 expr) si env)    ; evaluate numerator argument to a0
     (emit "  sd a0, (~a)" (constant heap-register))  ; store numerator at offset 0
     (emit-expr (primcall-operand2 expr) (- si (constant wordsize)) env) ; evaluate denominator
     (emit "  sd a0, ~a(~a)" (constant wordsize) (constant heap-register)) ; store denominator at offset wordsize
     (emit "  ori a0,~a,~a" (constant heap-register) (constant ratnum-tag)) ; tag pointer with #b101
     (emit "  addi ~a,~a,~a" (constant heap-register) (constant heap-register) (* 2 (constant wordsize)))] ; advance heap by 2 words
    ))

(define (emit-side-effect-primcall op expr si env)
  (case op
    [(vector-set!) ; vec n obj
     (with-saved-registers [si ("s4" "s5")]
       (emit-expr (primcall-operand1 expr) si env)
       (emit "  li t0,~a" (bitwise-not (constant vector-tag)))
       (emit "  and s4,a0,t0") ; clear vector tag and move to s4
       (emit-expr (primcall-operand2 expr) si env)
       (emit "  srai s5,a0,~a" (constant fixnum-shift))
       (emit "  addi s5,s5,1") ; skip over vector size
       (emit "  slli s5,s5,~a" (constant wordsize-shift)) ; multiply by wordsize
       (emit-expr (primcall-operand3 expr) si env) ; value in a0
       (emit "  add s4,s4,s5")
       (emit "  sd a0, (s4)"))]
    [else (error 'compile-program
                 "Unsupported primcall ~s in ~s" (pretty-format op) (pretty-format expr))]))

(define (emit-primitive-call expr si env)
  (let ([op (primcall-op expr)])
    (emit "/* ~a {{{ */" op)
    (case op
      [(cons make-vector string string->symbol make-ratnum)
       (emit-allocation-primcall op expr si env)]
      [(vector-set!)
       (emit-side-effect-primcall op expr si env)]
      [(void)
       (emit "li a0,~a" (constant void-value))]
      [(add1)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "addi a0,a0,~a" (immediate-rep 1))]
      [(sub1)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "addi a0,a0,~a" (immediate-rep -1))]
      [(zero?)
       (let ([L-zero (unique-label)]
             [L-end (unique-label)])
         (emit-expr (primcall-operand1 expr) si env)
         (emit "li a1, ~a" (immediate-rep 0))
         (emit "beq a0,a1,~a" L-zero)
         (emit "li a0, ~a" (constant false-value))
         (emit "j ~a" L-end)
         (emit-label L-zero)
         (emit "li a0, ~a" (constant true-value))
         (emit-label L-end))]
      [(not)
       (let ([L-false-operand (unique-label)]
             [L-end (unique-label)])
         (emit-expr (primcall-operand1 expr) si env)
         (emit "li a1, ~a" (immediate-rep #f))
         (emit "beq a0,a1,~a" L-false-operand)
         (emit "li a0, ~a" (immediate-rep #f))
         (emit "j ~a" L-end)
         (emit-label L-false-operand)
         (emit "li a0, ~a" (immediate-rep #t))
         (emit-label L-end))]
      [(null?)
       (emit-expr (primcall-operand1 expr) si env)
       (let ([L-null-operand (unique-label)]
             [L-end (unique-label)])
         (emit "li a1, ~a" (immediate-rep '()))
         (emit "beq a0,a1, ~a" L-null-operand)
         (emit "li a0, ~a" (immediate-rep #f))
         (emit "j ~a" L-end)
         (emit-label L-null-operand)
         (emit "li a0, ~a" (immediate-rep #t))
         (emit-label L-end))]
      [(list?)
       (emit-expr (primcall-operand1 expr) si env)
       (let ([L-is-list (unique-label)]
             [L-not-list (unique-label)]
             [L-end (unique-label)])
         (emit "li a1, ~a" (immediate-rep '()))
         (emit "beq a0,a1, ~a" L-is-list)
         (emit "andi a1,a0,0b111")
         (emit "li a2, ~a" (constant pair-tag))
         (emit "beq a1,a2, ~a" L-is-list)
         (emit-label L-not-list)
         (emit "li a0, ~a" (immediate-rep #f))
         (emit "j ~a" L-end)
         (emit-label L-is-list)
         (emit "li a0, ~a" (immediate-rep #t))
         (emit-label L-end))]
      [(vector?)
       (emit-expr (primcall-operand1 expr) si env)
       (let ([L-is-vector (unique-label)]
             [L-end (unique-label)])
         (emit "andi a1,a0,0b111")
         (emit "li a2, ~a" (constant vector-tag))
         (emit "beq a1,a2, ~a" L-is-vector)
         (emit "li a0, ~a" (immediate-rep #f))
         (emit "j ~a" L-end)
         (emit-label L-is-vector)
         (emit "li a0, ~a" (immediate-rep #t))
         (emit-label L-end))]
      [(rational?)
       (emit-expr (primcall-operand1 expr) si env)
       (let ([end-label (unique-label "rat_end")])
         ; Check if fixnum (low 2 bits are 00)
         (emit "andi a1,a0,0b11")
         (emit "beqz a1,~a" end-label)
         ; Check if ratnum (low 3 bits are 101)
         (emit "andi a1,a0,0b111")
         (emit "li a2,~a" (constant ratnum-tag))
         (emit "bne a1,a2,not_ratnum_~a" end-label)
         (emit-label end-label)
         ; If a1 == ratnum-tag or a1 == 0 (fixnum), result is #t
         (emit "li a0, ~a" (immediate-rep #t))
         (emit "j rat_end_~a" end-label)
         (emit "not_ratnum_~a:" end-label)
         (emit "li a0, ~a" (immediate-rep #f))
         (emit "rat_end_~a:" end-label))]
      [(number?)
       (emit-expr (primcall-operand1 expr) si env)
       (let ([end-label (unique-label "num_end")])
         ; Check if fixnum (low 2 bits are 00)
         (emit "andi a1,a0,0b11")
         (emit "beqz a1,~a" end-label)
         ; Check if ratnum (low 3 bits are 101)
         (emit "andi a1,a0,0b111")
         (emit "li a2,~a" (constant ratnum-tag))
         (emit "bne a1,a2,not_number_~a" end-label)
         (emit-label end-label)
         ; If a1 == ratnum-tag or a1 == 0 (fixnum), result is #t
         (emit "li a0, ~a" (immediate-rep #t))
         (emit "j num_end_~a" end-label)
         (emit "not_number_~a:" end-label)
         (emit "li a0, ~a" (immediate-rep #f))
         (emit "num_end_~a:" end-label))]
      [(exact?)
       (emit-expr (primcall-operand1 expr) si env)
       (let ([end-label (unique-label "exact_end")])
         ; Check if fixnum (low 2 bits are 00)
         (emit "andi a1,a0,0b11")
         (emit "beqz a1,~a" end-label)
         ; Check if ratnum (low 3 bits are 101)
         (emit "andi a1,a0,0b111")
         (emit "li a2,~a" (constant ratnum-tag))
         (emit "bne a1,a2,not_exact_~a" end-label)
         (emit-label end-label)
         ; If a1 == ratnum-tag or a1 == 0 (fixnum), result is #t
         (emit "li a0, ~a" (immediate-rep #t))
         (emit "j exact_end_~a" end-label)
         (emit "not_exact_~a:" end-label)
         (emit "li a0, ~a" (immediate-rep #f))
         (emit "exact_end_~a:" end-label))]
      [(integer?)
       (emit-expr (primcall-operand1 expr) si env)
       ; Only fixnums are integers (low 2 bits must be 00)
       (emit "andi a1,a0,0b11")
       (let ([is-fixnum (unique-label "int_is_fixnum")]
             [end-label (unique-label "int_end")])
         (emit "beqz a1,~a" is-fixnum)
         (emit "li a0, ~a" (immediate-rep #f))
         (emit "j ~a" end-label)
         (emit-label is-fixnum)
         (emit "li a0, ~a" (immediate-rep #t))
         (emit-label end-label))]
      [(numerator)
       (emit-expr (primcall-operand1 expr) si env)
       ; Check if fixnum (low 2 bits are 00)
       (emit "andi a1,a0,0b11")
       (let ([is-fixnum (unique-label "num_fixnum")]
             [done (unique-label "num_done")])
         (emit "beqz a1,~a" done)
         ; Is ratnum: clear tag and load first word (numerator)
         (emit "li a2,~a" (bitwise-not (constant ratnum-tag)))
         (emit "and a0,a0,a2")
         (emit "ld a0,(a0)")
         (emit-label done))]
      [(denominator)
       (emit-expr (primcall-operand1 expr) si env)
       ; Check if fixnum (low 2 bits are 00)
       (emit "andi a1,a0,0b11")
       (let ([is-fixnum (unique-label "den_fixnum")]
             [done (unique-label "den_done")])
         (emit "beqz a1,~a" done)
         ; Is ratnum: clear tag and load second word (denominator)
         (emit "li a2,~a" (bitwise-not (constant ratnum-tag)))
         (emit "and a0,a0,a2")
         (emit "ld a0,~a(a0)" (constant wordsize))
         (emit "j ~a" done)
         (emit-label done)
         ; If fixnum, return 1 as fixnum
         (emit "li a0,~a" (immediate-rep 1)))]
      [(integer->char)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "slli a0,a0,~a" (- (constant char-shift) (constant fixnum-shift)))
       (emit "ori  a0,a0,~a" (constant char-tag))]
      [(char->integer)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "srai a0,a0,~a" (- (constant char-shift) (constant fixnum-shift)))]
      [(+)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "sd a0,~a(sp)" si)
       (emit-expr (primcall-operand2 expr) (- si (constant wordsize)) env)
       (emit "ld a1,~a(sp)" si)
       (emit "add a0,a0,a1")]
      [(-)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "sd a0,~a(sp)" si)
       (emit-expr (primcall-operand2 expr) (- si (constant wordsize)) env)
       (emit "ld a1,~a(sp)" si)
       (emit "sub a0,a1,a0")]
      [(=)
       (emit "# numeric equality {{{")
       (emit-expr (primcall-operand1 expr) si env)
       (emit "sd a0,~a(sp)" si)
       (emit-expr (primcall-operand2 expr) (- si (constant wordsize)) env)
       (emit "ld a1,~a(sp)" si)
       (emit "mv a2, a0")
       (emit "mv a3, a1")
       (with-saved-registers [si ("s4" "s5" "s6")]
         (let ([both-fixnum (unique-label "num_eq_both_fixnum")]
               [both-ratnum (unique-label "num_eq_both_ratnum")]
               [check-mixed (unique-label "num_eq_check_mixed")]
               [false-ret (unique-label "num_eq_false")]
               [true-ret (unique-label "num_eq_true")]
               [done-ret (unique-label "num_eq_done")])
           (emit "andi s4, a2, 0b11")
           (emit "andi s5, a3, 0b11")
           (emit "or s6, s4, s5")
           (emit "beq s6, x0, ~a" both-fixnum)

           (emit "andi s4, a2, ~a" (constant ptr-mask))
           (emit "andi s5, a3, ~a" (constant ptr-mask))
           (emit "li s6, ~a" (constant ratnum-tag))
           (emit "bne s4, s6, ~a" check-mixed)
           (emit "beq s5, s6, ~a" both-ratnum)

           (emit-label check-mixed)
           (emit "j ~a" false-ret)

           (emit-label both-fixnum)
           (emit "beq a2, a3, ~a" true-ret)
           (emit "j ~a" false-ret)

           (emit-label both-ratnum)
           (emit "li s6, ~a" (bitwise-not (constant ptr-mask)))
           (emit "and s4, a3, s6")
           (emit "and s5, a2, s6")
           (emit "ld a3, 0(s4)")
           (emit "ld a2, 0(s5)")
           (emit "bne a2, a3, ~a" false-ret)
           (emit "ld a3, ~a(s4)" (constant wordsize))
           (emit "ld a2, ~a(s5)" (constant wordsize))
           (emit "beq a2, a3, ~a" true-ret)

           (emit-label false-ret)
           (emit "li a0, ~a" (immediate-rep #f))
           (emit "j ~a" done-ret)

           (emit-label true-ret)
           (emit "li a0, ~a" (immediate-rep #t))

           (emit-label done-ret)
           (emit "# numeric equality }}}")))]

      [(eq? eqv?)
       (let ([L-operands-equal (unique-label)]
             [L-end (unique-label)])
         (emit-expr (primcall-operand1 expr) si env)
         (emit "sd a0,~a(sp)" si)
         (emit-expr (primcall-operand2 expr) (- si (constant wordsize)) env)
         (emit "ld a1,~a(sp)" si)
         (emit "  beq a0,a1, ~a" L-operands-equal)
         (emit "li a0, ~a" (immediate-rep #f))
         (emit "j ~a" L-end)
         (emit-label L-operands-equal)
         (emit "li a0, ~a" (immediate-rep #t))
         (emit-label L-end))]
      [(<)
       (emit "# less-than with ratnum support {{{")
       (emit-expr (primcall-operand1 expr) si env)
       (emit "sd a0,~a(sp)" si)
       (emit-expr (primcall-operand2 expr) (- si (constant wordsize)) env)
       (emit "ld a1,~a(sp)" si)
       (emit "mv a2, a0")
       (emit "mv a3, a1")
       (with-saved-registers [si ("s4" "s5" "s6" "s7" "s8" "s9")]
         (let ([both-fixnum (unique-label "lt_both_fixnum")]
               [both-ratnum (unique-label "lt_both_ratnum")]
               [check-mixed (unique-label "lt_check_mixed")]
               [mixed-fix1-rat2 (unique-label "lt_mixed_fix1_rat2")]
               [mixed-rat1-fix2 (unique-label "lt_mixed_rat1_fix2")]
               [false-ret (unique-label "lt_false")]
               [true-ret (unique-label "lt_true")]
               [done-ret (unique-label "lt_done")])
           ; Check if both are fixnums (low 2 bits both 0)
