           (emit "and s5, a2, s6")
           (emit "ld s7, 0(s4)")
           (emit "ld s8, ~a(s4)" (constant wordsize))
           (emit "ld a4, 0(s5)")
           (emit "ld a5, ~a(s5)" (constant wordsize))
