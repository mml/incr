       (emit-expr (primcall-operand1 expr) si env)
       (emit "  li a1,~a" (bitwise-not (constant vector-tag)))
       (emit "  and a0,a0,a1")
       (emit "  ld a0, (a0)")
       (emit "  slli a0,a0, ~a" (constant fixnum-shift))]
      [(vector-ref)
       (with-saved-registers [si ("s4")]
         (emit-expr (primcall-operand1 expr) si env)
         (emit "  li t0,~a" (bitwise-not (constant vector-tag)))
         (emit "  and s4,a0,t0")
         (emit-expr (primcall-operand2 expr) si env) ; offset in a0
         (emit "  srli a1,a0,~a" (constant fixnum-shift)); // "offset fixnum->int"
         (emit "  addi a1,a1,1");               // "skip over vector size"
         (emit "  slli a1,a1,~a" (constant wordsize-shift)); // "multiply by wordsize"
         (emit "  add s4,s4,a1")
         (emit "  ld a0, (s4)"))];            // "dereference and return"

      [(string-ref)
       (with-saved-registers [si ("s4")]
         (emit-expr (primcall-operand1 expr) si env)
         (emit "  li t0,~a" (bitwise-not (constant string-tag)))
         (emit "  and s4,a0,t0")                ; // "clear string tag"
         (emit-expr (primcall-operand2 expr) si env) ; index in a0 (fixnum)
         (emit "  srli a1,a0,~a" (constant fixnum-shift)); // "index fixnum->int"
         (emit "  addi a1,a1,~a" (constant wordsize));   // "skip size header"
         (emit "  add s4,s4,a1")
         (emit "  lbu a0, (s4)")              ; // "load byte unsigned"
         (emit "  slli a0,a0,~a" (constant char-shift));  // "byte->char position"
         (emit "  ori a0,a0,~a" (constant char-tag)))];   // "add char tag"

      [(/)
       ; Division with GCD reduction and sign normalization
       (emit-expr (primcall-operand1 expr) si env)          ; dividend in a0
       (emit "mv s4,a0")                                     ; s4 = dividend (fixnum)
       (emit-expr (primcall-operand2 expr) (- si (constant wordsize)) env) ; divisor in a0
       (emit "mv s5,a0")                                     ; s5 = divisor (fixnum)
       (emit "srai a0,a0,~a" (constant fixnum-shift))       ; divisor as int
       (emit "srai a1,s4,~a" (constant fixnum-shift))       ; dividend as int
       (emit "div a2,a1,a0")                                 ; a2 = quotient
       (emit "mul a3,a2,a0")                                 ; a3 = quotient * divisor
       (emit "sub a3,a1,a3")                                 ; a3 = remainder
       (emit "beqz a3,div_exact")                            ; if remainder == 0, exact path
       ; Inexact path: create ratnum with GCD reduction
       ; Sign normalization: move sign to numerator
       (emit "mv a0,s5")                                     ; a0 = divisor
       (emit "bgez a0,norm_done")                            ; if non-negative, skip normalization
       ; Divisor is negative: negate both numerator and denominator
       (emit "neg s4,s4")                                    ; s4 = -s4 (negate numerator)
       (emit "neg s5,s5")                                    ; s5 = -s5 (negate denominator)
       (emit "norm_done:")
       ; GCD reduction: compute GCD(|numerator|, |denominator|) and reduce
       (emit "srai a0,s4,~a" (constant fixnum-shift))       ; a0 = numerator as int
       (emit "srai a1,s5,~a" (constant fixnum-shift))       ; a1 = denominator as int
       ; Make both positive for GCD computation
       (emit "bgez a0,abs_num_done")
       (emit "neg a0,a0")
       (emit "abs_num_done:")
       (emit "bgez a1,abs_den_done")
       (emit "neg a1,a1")
       (emit "abs_den_done:")
       ; GCD loop: a0 = a, a1 = b
       (emit "beqz a1,gcd_done")
       (emit "gcd_loop:")
       (emit "beqz a1,gcd_done")
       (emit "mv a2,a0")                                     ; a2 = a
       (emit "mv a0,a1")                                     ; a0 = b
       (emit "div a3,a2,a1")                                 ; a3 = a / b
       (emit "mul a3,a3,a1")                                 ; a3 = (a/b)*b
       (emit "sub a1,a2,a3")                                 ; a1 = a % b
       (emit "j gcd_loop")
       (emit "gcd_done:")
       ; a0 now contains GCD
       ; Reduce numerator and denominator by GCD
       (emit "srai a1,s4,~a" (constant fixnum-shift))       ; a1 = original numerator as int
       (emit "div a1,a1,a0")                                 ; a1 = numerator / GCD
       (emit "slli a1,a1,~a" (constant fixnum-shift))       ; a1 = reduced numerator as fixnum
       (emit "sd a1,(~a)" (constant heap-register))          ; store reduced numerator
       (emit "srai a2,s5,~a" (constant fixnum-shift))       ; a2 = original denominator as int
       (emit "bgez a2,abs_final_done")
       (emit "neg a2,a2")
       (emit "abs_final_done:")
       (emit "div a2,a2,a0")                                 ; a2 = abs(denom) / GCD
       (emit "slli a2,a2,~a" (constant fixnum-shift))       ; a2 = reduced denominator as fixnum
       (emit "sd a2,~a(~a)" (constant wordsize) (constant heap-register)) ; store reduced denominator
       (emit "ori a0,~a,~a" (constant heap-register) (constant ratnum-tag)) ; tag
       (emit "addi ~a,~a,~a" (constant heap-register) (constant heap-register) (* 2 (constant wordsize)))
       (emit "j div_done")
       (emit "div_exact:")
       ; Exact path: return quotient as fixnum
       (emit "slli a0,a2,~a" (constant fixnum-shift))
       (emit "div_done:")]

      [(quotient)
       (emit-expr (primcall-operand1 expr) si env)           ; dividend in a0 (fixnum)
       (emit "sd a0,~a(sp)" si)                              ; save dividend
       (emit-expr (primcall-operand2 expr) (- si (constant wordsize)) env)  ; divisor in a0 (fixnum)
       (emit "ld a1,~a(sp)" si)                              ; load dividend into a1
       (emit "srai a0,a0,~a" (constant fixnum-shift))        ; divisor fixnum->int
       (emit "srai a1,a1,~a" (constant fixnum-shift))        ; dividend fixnum->int
       (emit "div a0,a1,a0")                                 ; a0 = a1 / a0 (dividend_int/divisor_int)
       (emit "slli a0,a0,~a" (constant fixnum-shift))]       ; int->fixnum

      [(remainder)
       (emit-expr (primcall-operand1 expr) si env)           ; dividend in a0 (fixnum)
       (emit "sd a0,~a(sp)" si)                              ; save dividend
       (emit-expr (primcall-operand2 expr) (- si (constant wordsize)) env)  ; divisor in a0 (fixnum)
       (emit "ld a1,~a(sp)" si)                              ; load dividend into a1
       (emit "srai a0,a0,~a" (constant fixnum-shift))        ; divisor fixnum->int
       (emit "srai a1,a1,~a" (constant fixnum-shift))        ; dividend fixnum->int
       (emit "rem a0,a1,a0")                                 ; a0 = remainder (int)
       (emit "slli a0,a0,~a" (constant fixnum-shift))]       ; int->fixnum

      [(modulo)
       (let ([L-same-sign (unique-label "modulo_same_sign")]
             [L-end (unique-label "modulo_end")])
         (emit-expr (primcall-operand1 expr) si env)         ; dividend in a0 (fixnum)
         (emit "sd a0,~a(sp)" si)                            ; save dividend
         (emit-expr (primcall-operand2 expr) (- si (constant wordsize)) env)  ; divisor in a0 (fixnum)
         (emit "sd a0,~a(sp)" (- si (constant wordsize)))    ; save divisor on stack
         (emit "mv t2,a0")                                   ; save divisor in t2
         (emit "ld a1,~a(sp)" si)                            ; load dividend into a1
         (emit "srai a0,a0,~a" (constant fixnum-shift))      ; divisor fixnum->int
         (emit "srai a1,a1,~a" (constant fixnum-shift))      ; dividend fixnum->int
         (emit "rem a0,a1,a0")                               ; a0 = remainder (int)
         (emit "slli a0,a0,~a" (constant fixnum-shift))      ; remainder int->fixnum
         ; Check if remainder is 0
         (emit "beqz a0,~a" L-end)                           ; if rem == 0, done
         ; Check if signs differ: XOR and test sign bit
         (emit "xor t1,a0,t2")                               ; XOR remainder and divisor
         (emit "bgez t1,~a" L-same-sign)                     ; if same sign (>=0), done
         ; Different signs: add divisor to remainder
         (emit "add a0,a0,t2")                               ; remainder += divisor
         (emit-label L-same-sign)
         (emit-label L-end))]

      [else (error 'compile-program "Unsupported primcall in ~s" (pretty-format expr))])
    (emit "/* }}} end ~a */" op )))

(define (immediate-rep x)
  (cond [(integer? x) (shift (constant fixnum-shift) x)]
        [(boolean? x)
         (case x
           [(#f) (constant false-value)]
           [(#t) (constant true-value)])]
        [(char? x)
         (bitwise-or
           (shift (constant char-shift) (char->integer x))
           (constant char-tag))]
        [(null? x) (constant null-value)]
        [else (error 'compile-program "Unsupported immediate ~s" (pretty-format x))]))

(define (emit-begin-function name)
  (emit "")
  (emit "  .align 1")
  (emit "  .globl  ~a" name)
  (emit "  .type   ~a, @function" name)
  (emit-label name))

(define (emit-label l)
  (emit "~a:" l))

(define (emit-Closure label free* si env)
  (let* ([nfree (length free*)]               ; number of free variables
         [size (add1 nfree)]                  ; plus 1 for the label address
         [size (* (constant wordsize) size)]           ; in words
         [size (bitwise-and -8 (+ 11 size))]) ; align to next dword
    (emit "  la a0,~a /* ~a */" (lookup label env) label)
    (emit "  sd a0,(~a)" (constant heap-register))
    (let loop ([free* free*] [index (constant wordsize)])
      (unless (null? free*)
        (emit-varref (car free*) env)
        (emit "  sd a0,~a(~a)" index (constant heap-register))
        (loop (cdr free*) (+ index (constant wordsize)))))
    (emit "  ori a0,~a,~a" (constant heap-register) (constant closure-tag))
    (emit "  addi ~a,~a,~a" (constant heap-register) (constant heap-register) size)))


; emit-Tailcall sets up a tail call and then branches
(define (emit-Tailcall f e* si env)
  ; We are clobbering our incoming stack frame.  Even the LR, which we really
  ; should save.  We restore it first as a kludge.  In the future, we should
  ; emit a special Lx_tail label pointing to the spot right after where we save
  ; the LR on the stack.  Then we can branch to there instead.
  (emit-expr f si env) ; a0 = closure
  (emit "  li t0,~a" (bitwise-not (constant closure-tag)))
  (emit "  and a0,a0,t0 /* clear tailcall tag bits */") ; clear tag bits
  (emit "  sd a0, ~a(sp)" (get-stack-index 'closure)) ; put closure on the stack
  ; We now have to evaluate all arguments and gradually add their values to the stack.
  (let loop ([e* e*] [arg-index arg0-index] [arg-count 0] [si arg0-index])
    (cond
      [(null? e*)
       (emit "  ld a0,~a(sp)" (get-stack-index 'closure))
       (emit "  ld a0,(a0) /* load branch target */")
       (emit "  ld ra,~a(sp)" (get-stack-index 'link-register))
       (emit "  jr a0")]
      [else
        (emit-expr (car e*) si env)
        (emit "  sd a0, ~a(sp)" arg-index)
        (loop (cdr e*) (- arg-index (constant wordsize)) (add1 arg-count) (- si (constant wordsize)))])))


(define arg0-index (* -3 (constant wordsize)))
; emit-Funcall sets up a call and then branches
(define (emit-Funcall f e* si env)
  (emit-expr f si env) ; a0 = closure
  (let ([psi si]) ; procedure SI
    (emit "  li t0,~a" (bitwise-not (constant closure-tag)))
    (emit "  and a0,a0,t0")
    (emit "  sd a0, ~a(sp)" (+ psi (get-stack-index 'closure)))
    (let loop ([e* e*] [arg-index (+ psi arg0-index)] [arg-count 0] [si (+ psi arg0-index)])
      (cond
        [(null? e*)
         (emit "  ld ~a, ~a(sp) /* load closure from stack */" closure-register (+ psi (get-stack-index 'closure)))
         (emit "  ld ~a, (~a) /* dereference code pointer */" closure-register closure-register)
         (emit "  addi sp,sp,~a /* set procedure SP */" psi )
         (emit "  jalr ra,~a,0" closure-register)
         (emit "  addi sp,sp,~a /* restore SP */" (- psi))
         (emit "  ld ~a, ~a(sp) /* restore closure address */" closure-register (get-stack-index 'closure))]
        [else
          (emit-expr (car e*) si env)
          (emit "  sd a0, ~a(sp) /* store arg ~a */" arg-index arg-count)
          (loop (cdr e*) (- arg-index (constant wordsize)) (add1 arg-count) (- si (constant wordsize)))]))))


(define (emit-end-function name)
  (emit "  .size ~a, .-~a" name name))

; Currently unused
(define (emit-bss dlabels)
  (let ([names dlabels])
    ; TODO: should these be locals?
    (for-each (lambda (name) (emit ".globl ~a" name))
              names)
    (emit ".bss")
    (emit ".align ~a" (constant wordsize-shift))
    (for-each (lambda (name)
                (emit ".type ~a, @object" name)
                (emit ".size ~a, ~a" name (constant wordsize))
                (emit-label name)
                (emit ".zero ~a" (constant wordsize)))
              names)))

(define (emit-epilogue)
  (emit ".ident         \"mml scheme compiler\"")
  (emit ".section       .note.GNU-stack,\"\",@progbits"))
