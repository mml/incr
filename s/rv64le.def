           (emit-label both-fixnum)
           (emit "blt a3, a2, ~a" true-ret)
           (emit "j ~a" false-ret)

           ; Both are ratnums - cross-product comparison
           ; a3 = ratnum1 (tagged), a2 = ratnum2 (tagged)
           ; For a/b < c/d: compare a*d < c*b
