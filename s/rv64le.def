#lang racket

(provide emit-prologue)
(provide emit-Labels)
(provide emit-epilogue)
(require "compile-shared.ss")

(define (shift n-bits val)
  (arithmetic-shift val n-bits))
(define fixnum-shift 2)
; TODO: maybe make a fresh on one each compile-program invocation?
(define (make-labeler)
  (let ([x 0])
    (lambda (prefix)
      (set! x (+ x 1))
      (format "~a~a" prefix x))))

(define /unique-label (make-labeler))
(define unique-label
  (case-lambda
    [() (/unique-label "L")]
    [(prefix) (/unique-label prefix)]))


(define (emit . args)
  (apply fprintf (compile-port) args)
  (newline (compile-port)))

(define (emit-prologue)
  (emit "  .option pic")
  (emit "  .attribute arch, \"rv64i2p1_m2p0_a2p1_f2p2_d2p2_c2p0_zicsr2p0_zifencei2p0\"")
  (emit "  .attribute unaligned_access, 0")
  (emit "  .attribute stack_align, 16")
  (emit "  .text")
  (emit "  .align	1"))

(define (emit-Labels expr) (match expr
  [`(labels ([,x* ,code*] ___) ,body)
    (let ([env (emit-Def* x* code*)])
      (emit-scheme-entry body env))]))

(define (emit-Def* x* code*)
  (let ([env (map (lambda (x) (cons x (unique-label))) x*)])
    (let loop ([x* x*] [code* code*])
      (cond [(null? x*) env]
            [else
              (emit-Def (car x*) (car code*) env)
              (loop (cdr x*) (cdr code*))]))))

(define (emit-Def x code env)
  (error 'unimplemented))

(define (emit-scheme-entry expr env)
  (emit-begin-function "scheme_entry")
  (emit-expr expr #xdeadbeef env) ; TODO: Stack index
  (emit-label "scheme_return")
  (emit "  ret")
  (emit-end-function "scheme_entry"))

(define (emit-expr expr si env) (match expr
  [`(quote ,c) (emit "  li a0, ~a" (immediate-rep c))]
  [`(primcall ,pr ,e* ___) (emit-primitive-call `(,pr ,@e*) si env)]
  ))

(define (emit-primitive-call expr si env)
  (let ([op (primcall-op expr)])
    (case op
      [(add1)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "addiw a0,a0,~a" (immediate-rep 1))]
      [(sub1)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "addiw a0,a0,~a" (immediate-rep -1))]
      [(zero?)
       (let ([L-zero (unique-label)]
             [L-end (unique-label)])
         (emit-expr (primcall-operand1 expr) si env)
         (emit "li a1, ~a" (immediate-rep 0))
         (emit "beq a0,a1,~a" L-zero)
         (emit "li a0, ~a" (constant false-value))
         (emit "j ~a" L-end)
         (emit-label L-zero)
         (emit "li a0, ~a" (constant true-value))
         (emit-label L-end))]
      [(not)
       (let ([L-false-operand (unique-label)]
             [L-end (unique-label)])
         (emit-expr (primcall-operand1 expr) si env)
         (emit "li a1, ~a" (immediate-rep #f))
         (emit "beq a0,a1,~a" L-false-operand)
         (emit "li a0, ~a" (immediate-rep #f))
         (emit "j ~a" L-end)
         (emit-label L-false-operand)
         (emit "li a0, ~a" (immediate-rep #t))
         (emit-label L-end))]
      [(null?)
       (emit-expr (primcall-operand1 expr) si env)
       (let ([L-null-operand (unique-label)]
             [L-end (unique-label)])
         (emit "li a1, ~a" (immediate-rep '()))
         (emit "beq a0,a1, ~a" L-null-operand)
         (emit "li a0, ~a" (immediate-rep #f))
         (emit "j ~a" L-end)
         (emit-label L-null-operand)
         (emit "li a0, ~a" (immediate-rep #t))
         (emit-label L-end))]
      [(integer->char)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "slli a0,a0,~a" (- (constant char-shift) fixnum-shift))
       (emit "ori  a0,a0,~a" (constant char-tag))]
      [(char->integer)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "srai a0,a0,~a" (- (constant char-shift) fixnum-shift))]
      [else (error 'compile-program "Unsupported primcall in ~s" (pretty-format expr))])))

(define (immediate-rep x)
  (cond [(integer? x) (shift fixnum-shift x)]
        [(boolean? x)
         (case x
           [(#f) (constant false-value)]
           [(#t) (constant true-value)])]
        [(char? x)
         (bitwise-or
           (shift (constant char-shift) (char->integer x))
           (constant char-tag))]
        [(null? x) (constant null-value)]
        [else (error 'compile-program "Unsupported immediate ~s" (pretty-format x))]))

(define (emit-begin-function name)
  (emit "")
  (emit "  .align 1")
  (emit "  .globl  ~a" name)
  (emit "  .type   ~a, @function" name)
  (emit-label name))

(define (emit-label l)
  (emit "~a:" l))

(define (emit-end-function name)
  (emit "  .size ~a, .-~a" name name))


(define (emit-epilogue)
  (emit ".ident         \"mml scheme compiler\"")
  (emit ".section       .note.GNU-stack,\"\",@progbits"))
