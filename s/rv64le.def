           (emit "ld a4, 0(s5)")
           (emit "ld a5, ~a(s5)" (constant wordsize))
           (emit "mul s6, s7, a5")
           (emit "blt s6, a4, ~a" true-ret)
           (emit "j ~a" false-ret)

           ; Mixed: operand1 is ratnum, operand2 is fixnum
