#lang racket

(provide emit-prologue)
(provide emit-Labels)
(provide emit-epilogue)
(require "compile-shared.ss")

;;; https://riscv.org/wp-content/uploads/2015/01/riscv-calling.pdf
;;; https://en.wikichip.org/wiki/risc-v/registers
(define-constant wordsize 8)
(define-constant heap-register "s11") ; aka x27, highest numbered callee-saved register

; TODO: maybe make a fresh on one each compile-program invocation?
(define (make-labeler)
  (let ([x 0])
    (lambda (prefix)
      (set! x (+ x 1))
      (format "~a~a" prefix x))))

(define /unique-label (make-labeler))
(define unique-label
  (case-lambda
    [() (/unique-label "L")]
    [(prefix) (/unique-label prefix)]))


(define (emit . args)
  (apply fprintf (compile-port) args)
  (newline (compile-port)))

(define (emit-prologue)
  (emit "  .option pic")
  (emit "  .attribute arch, \"rv64i2p1_m2p0_a2p1_f2p2_d2p2_c2p0_zicsr2p0_zifencei2p0\"")
  (emit "  .attribute unaligned_access, 0")
  (emit "  .attribute stack_align, 16")
  (emit "  .text")
  (emit "  .align	1"))

(define (emit-Labels expr) (match expr
  [`(labels ([,x* ,code*] ___) ,body)
    (let ([env (emit-Def* x* code*)])
      (emit-scheme-entry body env))]))

(define (emit-Def* x* code*)
  (let ([env (map (lambda (x) (cons x (unique-label))) x*)])
    (let loop ([x* x*] [code* code*])
      (cond [(null? x*) env]
            [else
              (emit-Def (car x*) (car code*) env)
              (loop (cdr x*) (cdr code*))]))))

(define (emit-Def x code env)
  (error 'unimplemented))

(define (emit-scheme-entry expr env)
  (emit-begin-function "scheme_entry")
  (emit "  add ~a,a0,0" (constant heap-register)) ; Save heap base
  (emit-expr expr (- 0 (constant wordsize)) env)
  (emit-label "scheme_return")
  (emit "  ret")
  (emit-end-function "scheme_entry"))

(define (emit-expr expr si env) (match expr
  [`(quote ,c) (emit "  li a0, ~a" (immediate-rep c))]
  [(? symbol? x) (emit-varref x env)]
  [`(primcall ,pr ,e* ___) (emit-primitive-call `(,pr ,@e*) si env)]
  [`(let ,bindings ,body) (emit-let bindings body si env)]
  [`(begin ,e* ___) (emit-begin e* si env)]
  [`(if ,test ,conseq ,altern) (emit-if test conseq altern si env)]
  ))

(define (emit-varref x env)
  (let ([loc (lookup x env)])
    (if loc
        (emit "  ld a0,~a(~a)" (cdr loc) (car loc))
        (error 'compile-program "Internal error: unbound variable ~a" x))))

(define (emit-begin exprs si env)
  (cond
    [(null? exprs) (void)]
    [else (emit-expr (car exprs) si env)
          (emit-begin (cdr exprs) si env)]))

(define (emit-let bindings body si env)
  (let f ([b* bindings]
          [new-env env]
          [si si])
    (cond
      [(null? b*) (emit-expr body si new-env)]
      [else
        (let ([b (car b*)])
          (emit-expr (rhs b) si env)
          (emit " sd a0,~a(sp)" si)
          (f (cdr b*)
             (extend-env (lhs b) (cons "sp" si) new-env)
             (- si (constant wordsize))))])))

(define (emit-if test conseq altern si env)
  (let ([L0 (unique-label)]
        [L1 (unique-label)])
    (emit-expr test si env)
    (emit "  li a1, ~a" (immediate-rep #f))
    (emit "  beq a0,a1,~a" L0)
    (emit-expr conseq si env)
    (emit "  j ~a" L1)
    (emit-label L0)
    (emit-expr altern si env)
    (emit-label L1)))

(define (emit-allocation-primcall op expr si env)
  (case op
    [(cons)
     (emit-expr (primcall-operand1 expr) si env)
     (emit "  sd a0,~a(sp)" si)
     (emit-expr (primcall-operand2 expr) (- si (constant wordsize)) env)
     (emit "  sd a0, ~a(~a)" (constant wordsize) (constant heap-register)) ; store cdr
     (emit "  ld a0,~a(sp)" si) ; recover car
     (emit "  sd a0, (~a)" (constant heap-register))
     (emit "  add a0,~a,~a" (constant heap-register) (constant pair-tag))
     (emit "  add ~a,~a,~a" (constant heap-register) (constant heap-register) (* 2 (constant wordsize)))]
    [(make-vector) ; using only r0 and r1... could be more efficient
     (emit "  @ make-vector{{{")
     (emit-expr (primcall-operand1 expr) si env)
     (emit "  lsr r0, #~a" (constant fixnum-shift) #;(// "fixnum->int"))
     (emit "  str r0, [sp,#~a]" si      #;(// "save size on stack"))
     (emit "  lsl r0, #~a" (constant wordsize)   #;(// "<< (constant wordsize)"))
     (emit "  add r0, r0, #11"          #;(// "align size to next"))
     (emit "  and r0, r0, #-8"          #;(// "   object boundary"))
     (emit "  str ~a, [sp,#~a]" (constant heap-register) (- si (constant wordsize))) ; save address on stack
     (emit "  add ~a,~a,r0" (constant heap-register) (constant heap-register))
     (emit-expr (primcall-operand2 expr (shift (- (constant fixnum-shift)) #xdead0))
                (- si (constant wordsize) (constant wordsize)) env) ; r0 = initial value
     (emit "  ldr r2, [sp,#~a]" (- si (constant wordsize)) #;(// "pointer to vector"))
     (emit "  ldr r1, [sp,#~a]" si                #;(// "size"))
     (emit "  str r1, [r2],#~a" (constant wordsize)        #;(// "write size"))
     (let ([loop (unique-label "loop")] [break (unique-label "break")])
       (emit-label loop)
       (emit "  subs r1,r1,#1") ; decrement r1
       #;(emit-b 'mi break) ; if r1 < 0 goto break
       (emit "  str r0, [r2],#~a" (constant wordsize)) ; initialize word
       #;(emit-b 'always loop) ;
       (emit-label break))
     (emit "  ldr r0, [sp,#~a]" (- si (constant wordsize)) #;(// "restore pointer to vector"))
     (emit "  orr r0,r0,#~a" (constant vector-tag)           #;(// "tag vector"))
     (emit "  @ make-vector}}}")]
    ))

(define (emit-primitive-call expr si env)
  (let ([op (primcall-op expr)])
    (case op
      [(cons make-vector)
       (emit-allocation-primcall op expr si env)]
      [(add1)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "addiw a0,a0,~a" (immediate-rep 1))]
      [(sub1)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "addiw a0,a0,~a" (immediate-rep -1))]
      [(zero?)
       (let ([L-zero (unique-label)]
             [L-end (unique-label)])
         (emit-expr (primcall-operand1 expr) si env)
         (emit "li a1, ~a" (immediate-rep 0))
         (emit "beq a0,a1,~a" L-zero)
         (emit "li a0, ~a" (constant false-value))
         (emit "j ~a" L-end)
         (emit-label L-zero)
         (emit "li a0, ~a" (constant true-value))
         (emit-label L-end))]
      [(not)
       (let ([L-false-operand (unique-label)]
             [L-end (unique-label)])
         (emit-expr (primcall-operand1 expr) si env)
         (emit "li a1, ~a" (immediate-rep #f))
         (emit "beq a0,a1,~a" L-false-operand)
         (emit "li a0, ~a" (immediate-rep #f))
         (emit "j ~a" L-end)
         (emit-label L-false-operand)
         (emit "li a0, ~a" (immediate-rep #t))
         (emit-label L-end))]
      [(null?)
       (emit-expr (primcall-operand1 expr) si env)
       (let ([L-null-operand (unique-label)]
             [L-end (unique-label)])
         (emit "li a1, ~a" (immediate-rep '()))
         (emit "beq a0,a1, ~a" L-null-operand)
         (emit "li a0, ~a" (immediate-rep #f))
         (emit "j ~a" L-end)
         (emit-label L-null-operand)
         (emit "li a0, ~a" (immediate-rep #t))
         (emit-label L-end))]
      [(integer->char)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "slli a0,a0,~a" (- (constant char-shift) (constant fixnum-shift)))
       (emit "ori  a0,a0,~a" (constant char-tag))]
      [(char->integer)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "srai a0,a0,~a" (- (constant char-shift) (constant fixnum-shift)))]
      [(+)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "sw a0,~a(sp)" si)
       (emit-expr (primcall-operand2 expr) (- si (constant wordsize)) env)
       (emit "lw a1,~a(sp)" si)
       (emit "addw a0,a0,a1")]
      [(-)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "sw a0,~a(sp)" si)
       (emit-expr (primcall-operand2 expr) (- si (constant wordsize)) env)
       (emit "lw a1,~a(sp)" si)
       (emit "subw a0,a1,a0")]
      [(=)
       (let ([L-operands-equal (unique-label)]
             [L-end (unique-label)])
         (emit-expr (primcall-operand1 expr) si env)
         (emit "sw a0,~a(sp)" si)
         (emit-expr (primcall-operand2 expr) (- si (constant wordsize)) env)
         (emit "lw a1,~a(sp)" si)
         (emit "  beq a0,a1, ~a" L-operands-equal)
         (emit "li a0, ~a" (immediate-rep #f))
         (emit "j ~a" L-end)
         (emit-label L-operands-equal)
         (emit "li a0, ~a" (immediate-rep #t))
         (emit-label L-end))]
      [(<)
       (let ([L-return-true (unique-label)]
             [L-end (unique-label)])
         (emit-expr (primcall-operand1 expr) si env)
         (emit "sw a0,~a(sp)" si)
         (emit-expr (primcall-operand2 expr) (- si (constant wordsize)) env)
         (emit "lw a1,~a(sp)" si)
         (emit "  blt a1,a0, ~a" L-return-true)
         (emit "li a0, ~a" (immediate-rep #f))
         (emit "j ~a" L-end)
         (emit-label L-return-true)
         (emit "li a0, ~a" (immediate-rep #t))
         (emit-label L-end))]
      [(*)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "sw a0,~a(sp)" si)
       (emit-expr (primcall-operand2 expr) (- si (constant wordsize)) env)
       (emit "lw a1,~a(sp)" si)
       (emit "srai a0,a0,~a" (constant fixnum-shift))
       (emit "mul a0,a0,a1")]
      [(bitwise-arithmetic-shift-left bitwise-arithmetic-shift)
       (let ([L-negative-operand (unique-label)]
             [L-end (unique-label)])
         (emit-expr (primcall-operand1 expr) si env)
         (emit "sw a0,~a(sp)" si)
         (emit-expr (primcall-operand2 expr) (- si (constant wordsize)) env)
         (emit "lw a1,~a(sp)" si)
         (emit "srai a0,a0,~a" (constant fixnum-shift))
         (emit "srai a1,a1,~a" (constant fixnum-shift))
         (emit "blt a0,zero,~a" L-negative-operand)
         (emit "sll a0,a1,a0")
         (emit "j ~a" L-end)
         (emit-label L-negative-operand)
         (emit "sub a0,zero,a0")
         (emit "sra a0, a1, a0")
         (emit-label L-end)
         (emit "sll a0,a0,~a" (constant fixnum-shift)))]
      [(bitwise-arithmetic-shift-right)
       (let ([L-negative-operand (unique-label)]
             [L-end (unique-label)])
         (emit-expr (primcall-operand1 expr) si env)
         (emit "sw a0,~a(sp)" si)
         (emit-expr (primcall-operand2 expr) (- si (constant wordsize)) env)
         (emit "lw a1,~a(sp)" si)
         (emit "srai a0,a0,~a" (constant fixnum-shift))
         (emit "srai a1,a1,~a" (constant fixnum-shift))
         (emit "blt a0,zero,~a" L-negative-operand)
         (emit "sra a0, a1, a0")
         (emit "j ~a" L-end)
         (emit-label L-negative-operand)
         (emit "sub a0,zero,a0")
         (emit "sll a0,a1,a0")
         (emit-label L-end))
         (emit "slli a0,a0,~a" (constant fixnum-shift))]
      [(car)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "  li a1,~a" (constant pair-tag))
       (emit "  sub a0,a0,a1")
       (emit "  ld a0,(a0)")]
      [(cdr)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "  li a1,~a" (constant pair-tag))
       (emit "  sub a0,a0,a1")
       (emit "  ld a0,~a(a0)" (constant wordsize))]
      [(cadr)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "  li a1,~a" (constant pair-tag))
       (emit "  sub a0,a0,a1")
       (emit "  ld a0,~a(a0)" (constant wordsize))
       (emit "  sub a0,a0,a1")
       (emit "  ld a0,0(a0)")]
      [(cddr)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "  li a1,~a" (constant pair-tag))
       (emit "  sub a0,a0,a1")
       (emit "  ld a0,~a(a0)" (constant wordsize))
       (emit "  sub a0,a0,a1")
       (emit "  ld a0,~a(a0)" (constant wordsize))]
      [(caddr)
       (emit-expr (primcall-operand1 expr) si env)
       (emit "  li a1,~a" (constant pair-tag))
       (emit "  sub a0,a0,a1")
       (emit "  ld a0,~a(a0)" (constant wordsize))
       (emit "  sub a0,a0,a1")
       (emit "  ld a0,~a(a0)" (constant wordsize))
       (emit "  sub a0,a0,a1")
       (emit "  ld a0,(a0)")]

      [else (error 'compile-program "Unsupported primcall in ~s" (pretty-format expr))])))

(define (immediate-rep x)
  (cond [(integer? x) (shift (constant fixnum-shift) x)]
        [(boolean? x)
         (case x
           [(#f) (constant false-value)]
           [(#t) (constant true-value)])]
        [(char? x)
         (bitwise-or
           (shift (constant char-shift) (char->integer x))
           (constant char-tag))]
        [(null? x) (constant null-value)]
        [else (error 'compile-program "Unsupported immediate ~s" (pretty-format x))]))

(define (emit-begin-function name)
  (emit "")
  (emit "  .align 1")
  (emit "  .globl  ~a" name)
  (emit "  .type   ~a, @function" name)
  (emit-label name))

(define (emit-label l)
  (emit "~a:" l))

(define (emit-end-function name)
  (emit "  .size ~a, .-~a" name name))


(define (emit-epilogue)
  (emit ".ident         \"mml scheme compiler\"")
  (emit ".section       .note.GNU-stack,\"\",@progbits"))
